  <diagram id="_bGzLKCs5b7Ak4S5Eg5q" name="Trang-8">
    <mxGraphModel dx="4287" dy="2793" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    namespace VIEW {\n        class Main {\n            +main(args: String[]): void\n        }\n\n        class MainView {\n            -authController: AuthController\n            -browseController: BrowseController\n            -fanController: FanController\n            -bookingView: BookingView\n            -sellerView: SellerView\n            -gateView: GateView\n            -adminManagementView: AdminManagementView\n            -simulatorView: SimulatorView\n            +MainView(authController: AuthController, browseController: BrowseController, fanController: FanController, bookingView: BookingView, sellerView: SellerView, gateView: GateView, adminManagementView: AdminManagementView, simulatorView: SimulatorView)\n            +showGuestMenu(): void\n            +showFanMenu(): void\n            +showSellerMenu(): void\n            +showGateStaffMenu(): void\n            +showAdminMenu(): void\n            +showSimulatorMenu(): void\n            +start(): void\n        }\n\n        class AdminManagementView {\n            -stadiumController: StadiumController\n            -matchController: MatchController\n            -accountAdminController: AccountAdminController\n            -adminController: AdminController\n            -refundController: RefundController\n            +AdminManagementView(stadiumController: StadiumController, matchController: MatchController, accountAdminController: AccountAdminController, adminController: AdminController, refundController: RefundController)\n            +showStadiumMenu(): void\n            +showMatchMenu(): void\n            +showFanManagementMenu(): void\n            +showStaffManagementMenu(): void\n            +showRefundReviewMenu(): void\n            +showSystemSummary(): void\n            +showAuditLogs(): void\n            +showDataGenerationMenu(): void\n        }\n\n        class SeatMapView {\n            -browseController: BrowseController\n            +SeatMapView(browseController: BrowseController)\n            +displaySeatMap(matchId: Long): void\n        }\n\n        class BookingView {\n            -bookingController: BookingController\n            -refundController: RefundController\n            -seatMapView: SeatMapView\n            +BookingView(bookingController: BookingController, refundController: RefundController, seatMapView: SeatMapView)\n            +showBookingMenu(): void\n            +submitBooking(request: BookingRequest): void\n            +displayBookingResponse(response: BookingResponse): void\n            +showMyBookings(fanId: Long): void\n            +showMyTickets(fanId: Long): void\n            +showTicketDetails(ticketId: Long): void\n            +showRefundMenu(fanId: Long): void\n        }\n\n        class SellerView {\n            -fanController: FanController\n            -bookingController: BookingController\n            +SellerView(fanController: FanController, bookingController: BookingController)\n            +showSellerMenu(): void\n            +searchFan(keyword: String): void\n            +createFan(): void\n            +createBookingForFan(): void\n            +acceptOfflinePayment(): void\n            +issueTicket(): void\n        }\n\n        class GateView {\n            -ticketController: TicketController\n            +GateView(ticketController: TicketController)\n            +showGateMenu(): void\n            +validateTicket(ticketCode: String, matchId: Long): void\n            +checkInTicket(ticketCode: String, matchId: Long): void\n        }\n\n        class SimulatorView {\n            -simulationController: SimulationController\n            +SimulatorView(simulationController: SimulationController)\n            +showConfigurationMenu(): void\n            +startSimulation(simulationId: Long): void\n        }\n\n        class ReportView {\n            -simulationController: SimulationController\n            +ReportView(simulationController: SimulationController)\n            +displayResults(): void\n            +displayComparison(results: List~SimulationResult~): void\n            +exportResult(simulationId: Long, filePath: Path): void\n        }\n\n    }\n\n    namespace CONTROLLER {\n        class AuthController {\n            -fanRepository: FanRepository\n            -staffRepository: StaffRepository\n            -currentUser: User\n            +AuthController(fanRepository: FanRepository, staffRepository: StaffRepository)\n            +login(email: String, password: String): User\n            +logout(): void\n            +getCurrentUser(): User\n            +updateCurrentUserProfile(fullName: String, phone: String): User\n        }\n\n        class FanController {\n            -fanRepository: FanRepository\n            -bookingRepository: BookingRepository\n            -ticketRepository: TicketRepository\n            +FanController(fanRepository: FanRepository, bookingRepository: BookingRepository, ticketRepository: TicketRepository)\n            +register(fullName: String, email: String, password: String, phone: String): Fan\n            +searchFans(keyword: String): List~Fan~\n            +getMyTickets(fanId: Long): List~Ticket~\n        }\n\n        class BrowseController {\n            -matchRepository: MatchRepository\n            -matchSeatRepository: MatchSeatRepository\n            +BrowseController(matchRepository: MatchRepository, matchSeatRepository: MatchSeatRepository)\n            +searchMatches(keyword: String): List~Match~\n            +filterMatches(stadiumId: Long, startDate: LocalDate): List~Match~\n            +viewMatchDetails(matchId: Long): Match\n            +getSeatMap(matchId: Long): List~MatchSeat~\n        }\n\n        class StadiumController {\n            -stadiumRepository: StadiumRepository\n            -sectionRepository: SectionRepository\n            -seatRepository: SeatRepository\n            +StadiumController(stadiumRepository: StadiumRepository, sectionRepository: SectionRepository, seatRepository: SeatRepository)\n            +createStadium(name: String, address: String): Stadium\n            +getStadiums(): List~Stadium~\n            +getStadiumDetails(stadiumId: Long): Stadium\n            +updateStadium(stadiumId: Long, name: String, address: String): Stadium\n            +deleteStadium(stadiumId: Long): boolean\n            +createSection(stadiumId: Long, name: String): Section\n            +getSections(stadiumId: Long): List~Section~\n            +getSectionDetails(sectionId: Long): Section\n            +updateSection(sectionId: Long, name: String): Section\n            +deleteSection(sectionId: Long): boolean\n            +createSeat(sectionId: Long, rowLabel: String, seatNumber: int): Seat\n            +buildSeatMap(sectionId: Long): List~Seat~\n            +getSeatDetails(seatId: Long): Seat\n            +updateSeat(seatId: Long, rowLabel: String, seatNumber: int): Seat\n            +deleteSeat(seatId: Long): boolean\n            +activateSeat(seatId: Long): Seat\n            +deactivateSeat(seatId: Long): Seat\n        }\n\n        class MatchController {\n            -matchRepository: MatchRepository\n            -ticketPriceRepository: TicketPriceRepository\n            -matchSeatRepository: MatchSeatRepository\n            +MatchController(matchRepository: MatchRepository, ticketPriceRepository: TicketPriceRepository, matchSeatRepository: MatchSeatRepository)\n            +createMatch(stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime): Match\n            +getMatches(): List~Match~\n            +getMatchDetails(matchId: Long): Match\n            +updateMatch(match: Match): Match\n            +deleteMatch(matchId: Long): boolean\n            +createTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice\n            +getTicketPrices(matchId: Long): List~TicketPrice~\n            +getTicketPriceDetails(matchId: Long, sectionId: Long): TicketPrice\n            +updateTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice\n            +deleteTicketPrice(matchId: Long, sectionId: Long): boolean\n            +openTicketSales(matchId: Long): Match\n            +closeTicketSales(matchId: Long): Match\n            +getTicketSalesStatus(matchId: Long): SaleStatus\n        }\n\n        class AccountAdminController {\n            -fanRepository: FanRepository\n            -staffRepository: StaffRepository\n            +AccountAdminController(fanRepository: FanRepository, staffRepository: StaffRepository)\n            +createFanAccount(fullName: String, email: String, password: String, phone: String): Fan\n            +getFans(): List~Fan~\n            +getFanDetails(fanId: Long): Fan\n            +searchFans(keyword: String): List~Fan~\n            +filterFans(status: UserStatus): List~Fan~\n            +updateFan(fanId: Long, fullName: String, phone: String): Fan\n            +activateFan(fanId: Long): Fan\n            +deactivateFan(fanId: Long): Fan\n            +deleteFan(fanId: Long): boolean\n            +createStaffAccount(fullName: String, email: String, password: String, phone: String, role: UserRole): Staff\n            +getStaffs(): List~Staff~\n            +getStaffDetails(staffId: Long): Staff\n            +searchStaff(keyword: String): List~Staff~\n            +filterStaff(role: UserRole, status: UserStatus): List~Staff~\n            +updateStaff(staffId: Long, fullName: String, phone: String): Staff\n            +activateStaff(staffId: Long): Staff\n            +deactivateStaff(staffId: Long): Staff\n            +assignRole(staffId: Long, role: UserRole): Staff\n            +changeRole(staffId: Long, role: UserRole): Staff\n            +revokeRole(staffId: Long): Staff\n        }\n\n        class AdminController {\n            -dataGenerator: DataGenerator\n            -fanRepository: FanRepository\n            -staffRepository: StaffRepository\n            -stadiumRepository: StadiumRepository\n            -matchRepository: MatchRepository\n            -bookingRepository: BookingRepository\n            -ticketRepository: TicketRepository\n            -auditLogRepository: AuditLogRepository\n            +AdminController(dataGenerator: DataGenerator, fanRepository: FanRepository, staffRepository: StaffRepository, stadiumRepository: StadiumRepository, matchRepository: MatchRepository, bookingRepository: BookingRepository, ticketRepository: TicketRepository, auditLogRepository: AuditLogRepository)\n            +generateCsvDataset(recordCount: int): void\n            +getSystemSummary(): SystemSummary\n            +getAuditLogs(): List~AuditLog~\n        }\n\n        class RefundController {\n            -refundRepository: RefundRepository\n            -bookingRepository: BookingRepository\n            +RefundController(refundRepository: RefundRepository, bookingRepository: BookingRepository)\n            +requestRefund(fanId: Long, bookingId: Long, reason: String): RefundRequest\n            +reviewRefund(adminId: Long, requestId: Long, approve: boolean, note: String): RefundRequest\n        }\n\n        class BookingController {\n            -bookingRepository: BookingRepository\n            -ticketRepository: TicketRepository\n            -paymentRepository: PaymentRepository\n            -transactionRepository: TransactionRepository\n            -seatRepository: SeatRepository\n            -ticketPriceRepository: TicketPriceRepository\n            -strategyFactory: StrategyFactory\n            -mockPaymentService: MockPaymentService\n            +BookingController(bookingRepository: BookingRepository, ticketRepository: TicketRepository, paymentRepository: PaymentRepository, transactionRepository: TransactionRepository, seatRepository: SeatRepository, ticketPriceRepository: TicketPriceRepository, strategyFactory: StrategyFactory, mockPaymentService: MockPaymentService)\n            +validateTicketLimit(seatIds: List~Long~): void\n            +calculateTotal(matchId: Long, seatIds: List~Long~): BigDecimal\n            +createBooking(request: BookingRequest): BookingResponse\n            +createBookingForFan(sellerId: Long, request: BookingRequest): BookingResponse\n            +makeOnlinePayment(bookingId: Long, amount: BigDecimal): Payment\n            +acceptOfflinePayment(sellerId: Long, bookingId: Long, amount: BigDecimal): Payment\n            +issueTickets(bookingId: Long): List~Ticket~\n            +getMyBookings(fanId: Long): List~Booking~\n            +getBookingDetails(bookingId: Long): Booking\n            +getMyTickets(fanId: Long): List~Ticket~\n            +getTicketDetails(ticketId: Long): Ticket\n            +getTicketHistory(fanId: Long): List~Ticket~\n        }\n\n        class TicketController {\n            -ticketRepository: TicketRepository\n            +TicketController(ticketRepository: TicketRepository)\n            +validateTicket(ticketCode: String, matchId: Long): Ticket\n            +checkInTicket(ticketCode: String, matchId: Long): Ticket\n        }\n\n        class SimulationController {\n            -executor: ExecutorService\n            -strategyFactory: StrategyFactory\n            -simulationRepository: SimulationRepository\n            -resultRepository: SimulationResultRepository\n            +SimulationController(strategyFactory: StrategyFactory, simulationRepository: SimulationRepository, resultRepository: SimulationResultRepository)\n            +configureSimulation(matchId: Long, targetSeatIds: List~Long~, threadCount: int, mechanism: SyncMechanism): Simulation\n            +runSimulation(simulationId: Long): SimulationResult\n            +compareSyncMechanisms(simulationId: Long): List~SimulationResult~\n            +getResults(): List~SimulationResult~\n            +exportResult(simulationId: Long, filePath: Path): boolean\n            +shutdown(): void\n        }\n\n    }\n\n    namespace REPOSITORY {\n        class FanRepository {\n            +FanRepository(filePath: Path)\n            +findByEmail(email: String): Fan\n            +search(keyword: String): List~Fan~\n            #parseLine(line: String): Fan\n        }\n\n        class StaffRepository {\n            +StaffRepository(filePath: Path)\n            +findByEmail(email: String): Staff\n            +search(keyword: String): List~Staff~\n            #parseLine(line: String): Staff\n        }\n\n        class BookingRepository {\n            +BookingRepository(filePath: Path)\n            +findByFanId(fanId: Long): List~Booking~\n            #parseLine(line: String): Booking\n        }\n\n        class MatchRepository {\n            +MatchRepository(filePath: Path)\n            +findUpcoming(): List~Match~\n            #parseLine(line: String): Match\n        }\n\n        class MatchSeatRepository {\n            -filePath: Path\n            +MatchSeatRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~MatchSeat~\n            +find(matchId: Long, seatId: Long): MatchSeat\n            +save(seat: MatchSeat): MatchSeat\n            +updateWithoutLock(seat: MatchSeat): boolean\n            +updateSynchronized(seat: MatchSeat): boolean\n            +updateWithFileLock(seat: MatchSeat): boolean\n            +updateIfVersionMatches(seat: MatchSeat, expectedVersion: int): boolean\n        }\n\n        class TicketRepository {\n            +TicketRepository(filePath: Path)\n            +findByBookingId(bookingId: Long): List~Ticket~\n            +findByCode(ticketCode: String): Ticket\n            +findByFanId(fanId: Long): List~Ticket~\n            #parseLine(line: String): Ticket\n        }\n\n        class StadiumRepository {\n            +StadiumRepository(filePath: Path)\n            +findByName(name: String): List~Stadium~\n            #parseLine(line: String): Stadium\n        }\n\n        class SectionRepository {\n            +SectionRepository(filePath: Path)\n            +findByStadiumId(stadiumId: Long): List~Section~\n            #parseLine(line: String): Section\n        }\n\n        class SeatRepository {\n            +SeatRepository(filePath: Path)\n            +findBySectionId(sectionId: Long): List~Seat~\n            #parseLine(line: String): Seat\n        }\n\n        class TicketPriceRepository {\n            -filePath: Path\n            +TicketPriceRepository(filePath: Path)\n            +findPrice(matchId: Long, sectionId: Long): TicketPrice\n            +findByMatchId(matchId: Long): List~TicketPrice~\n            +save(price: TicketPrice): TicketPrice\n            +update(price: TicketPrice): TicketPrice\n            +delete(matchId: Long, sectionId: Long): boolean\n        }\n\n        class RefundRepository {\n            +RefundRepository(filePath: Path)\n            +findByFanId(fanId: Long): List~RefundRequest~\n            +findPending(): List~RefundRequest~\n            #parseLine(line: String): RefundRequest\n        }\n\n        class AuditLogRepository {\n            +AuditLogRepository(filePath: Path)\n            +append(log: AuditLog): void\n            +findRecent(limit: int): List~AuditLog~\n            #parseLine(line: String): AuditLog\n        }\n\n        class PaymentRepository {\n            +PaymentRepository(filePath: Path)\n            +findByBookingId(bookingId: Long): Payment\n            #parseLine(line: String): Payment\n        }\n\n        class TransactionRepository {\n            +TransactionRepository(filePath: Path)\n            +findBySimulationId(simulationId: Long): List~BookingTransaction~\n            #parseLine(line: String): BookingTransaction\n        }\n\n        class SimulationRepository {\n            +SimulationRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~Simulation~\n            #parseLine(line: String): Simulation\n        }\n\n        class SimulationResultRepository {\n            +SimulationResultRepository(filePath: Path)\n            +findBySimulationId(simulationId: Long): List~SimulationResult~\n            +exportResult(simulationId: Long, filePath: Path): boolean\n            #parseLine(line: String): SimulationResult\n        }\n\n        class CsvRepository~T~ {\n            &lt;&lt;abstract&gt;&gt;\n            #filePath: Path\n            +CsvRepository(filePath: Path)\n            +findAll(): List~T~\n            +findById(id: Long): T\n            +findByCondition(condition: Predicate~T~): List~T~\n            +save(entity: T): T\n            +update(entity: T): T\n            +delete(id: Long): boolean\n            #parseLine(line: String): T\n        }\n\n        class DataGenerator {\n            -outputDirectory: Path\n            +DataGenerator(outputDirectory: Path)\n            +generateAll(recordCount: int): void\n            +generateStadiums(): void\n            +generateSections(): void\n            +generateSeats(recordCount: int): void\n            +generateFans(): void\n            +generateStaff(): void\n            +generateMatches(): void\n            +clearGeneratedData(): void\n        }\n\n    }\n\n    namespace STRATEGY {\n        class BookingStrategy {\n            &lt;&lt;interface&gt;&gt;\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class StrategyFactory {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +StrategyFactory(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +create(mechanism: SyncMechanism): BookingStrategy\n        }\n\n        class MockPaymentService {\n            -successMode: boolean\n            +MockPaymentService(successMode: boolean)\n            +processPayment(bookingId: Long, amount: BigDecimal): boolean\n        }\n\n        class NoLockStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +NoLockStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class SynchronizedStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +SynchronizedStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class FileLockStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +FileLockStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class OptimisticLockStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            -maxRetries: int\n            +OptimisticLockStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository, maxRetries: int)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class BookingTask {\n            -startLatch: CountDownLatch\n            -strategy: BookingStrategy\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            +BookingTask(startLatch: CountDownLatch, strategy: BookingStrategy, fanId: Long, matchId: Long, seatIds: List~Long~)\n            +call(): BookingTransaction\n        }\n\n    }\n\n    namespace MODEL {\n        class BaseEntity {\n            &lt;&lt;abstract&gt;&gt;\n            #id: Long\n            +BaseEntity(id: Long)\n            +getId(): Long\n            +toCsvLine(): String\n            +fromCsvLine(line: String): BaseEntity\n        }\n\n        class User {\n            -fullName: String\n            -email: String\n            -passwordHash: String\n            -phone: String\n            -role: UserRole\n            -status: UserStatus\n            +User(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)\n            +updateProfile(fullName: String, phone: String): void\n            +changeStatus(status: UserStatus): void\n        }\n\n        class Fan {\n            -MAX_TICKETS_PER_TRANSACTION: int = 4\n            +Fan(id: Long, fullName: String, email: String, passwordHash: String, phone: String, status: UserStatus)\n            +canBook(ticketCount: int): boolean\n        }\n\n        class Staff {\n            +Staff(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)\n            +assignRole(role: UserRole): void\n        }\n\n        class Match {\n            -stadiumId: Long\n            -homeTeam: String\n            -awayTeam: String\n            -startTime: LocalDateTime\n            -saleStatus: SaleStatus\n            +Match(id: Long, stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime, saleStatus: SaleStatus)\n            +reschedule(startTime: LocalDateTime): void\n            +changeSaleStatus(status: SaleStatus): void\n        }\n\n        class MatchSeat {\n            -matchId: Long\n            -seatId: Long\n            -status: SeatStatus\n            -version: int\n            +MatchSeat(matchId: Long, seatId: Long, status: SeatStatus, version: int)\n            +isAvailable(): boolean\n            +lock(): void\n            +markBooked(): void\n            +release(): void\n        }\n\n        class UserRole {\n            &lt;&lt;enumeration&gt;&gt;\n            FAN\n            SELLER\n            GATE_STAFF\n            ADMIN\n            SIMULATOR_OPERATOR\n        }\n\n        class UserStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            ACTIVE\n            INACTIVE\n        }\n\n        class Stadium {\n            -name: String\n            -address: String\n            +Stadium(id: Long, name: String, address: String)\n            +updateDetails(name: String, address: String): void\n        }\n\n        class Section {\n            -stadiumId: Long\n            -name: String\n            +Section(id: Long, stadiumId: Long, name: String)\n            +rename(name: String): void\n        }\n\n        class Seat {\n            -sectionId: Long\n            -rowLabel: String\n            -seatNumber: int\n            -active: boolean\n            +Seat(id: Long, sectionId: Long, rowLabel: String, seatNumber: int, active: boolean)\n            +updateLocation(rowLabel: String, seatNumber: int): void\n            +activate(): void\n            +deactivate(): void\n        }\n\n        class TicketPrice {\n            -matchId: Long\n            -sectionId: Long\n            -amount: BigDecimal\n            +TicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal)\n            +updatePrice(amount: BigDecimal): void\n        }\n\n        class SaleStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            CLOSED\n            OPEN\n        }\n\n        class SeatStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            AVAILABLE\n            LOCKED\n            BOOKED\n        }\n\n        class RefundRequest {\n            -bookingId: Long\n            -fanId: Long\n            -reason: String\n            -status: RefundStatus\n            -requestedAt: LocalDateTime\n            -reviewedBy: Long\n            -reviewedAt: LocalDateTime\n            -reviewNote: String\n            +RefundRequest(id: Long, bookingId: Long, fanId: Long, reason: String, requestedAt: LocalDateTime)\n            +approve(adminId: Long, note: String, time: LocalDateTime): void\n            +reject(adminId: Long, note: String, time: LocalDateTime): void\n        }\n\n        class RefundStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            REQUESTED\n            APPROVED\n            REJECTED\n        }\n\n        class AuditLog {\n            -actorId: Long\n            -action: String\n            -targetType: String\n            -targetId: Long\n            -result: String\n            -createdAt: LocalDateTime\n            +AuditLog(id: Long, actorId: Long, action: String, targetType: String, targetId: Long, result: String, createdAt: LocalDateTime)\n            +toCsvLine(): String\n        }\n\n        class SystemSummary {\n            -fanCount: int\n            -staffCount: int\n            -stadiumCount: int\n            -matchCount: int\n            -bookingCount: int\n            -ticketCount: int\n            +SystemSummary(fanCount: int, staffCount: int, stadiumCount: int, matchCount: int, bookingCount: int, ticketCount: int)\n            +getTotalAccounts(): int\n        }\n\n        class BookingRequest {\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            +BookingRequest(fanId: Long, matchId: Long, seatIds: List~Long~)\n            +getFanId(): Long\n            +getMatchId(): Long\n            +getSeatIds(): List~Long~\n        }\n\n        class BookingResponse {\n            -bookingId: Long\n            -totalAmount: BigDecimal\n            -status: BookingStatus\n            +BookingResponse(bookingId: Long, totalAmount: BigDecimal, status: BookingStatus)\n            +getBookingId(): Long\n            +getTotalAmount(): BigDecimal\n            +getStatus(): BookingStatus\n        }\n\n        class Booking {\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            -totalAmount: BigDecimal\n            -status: BookingStatus\n            +Booking(id: Long, fanId: Long, matchId: Long, seatIds: List~Long~, totalAmount: BigDecimal, status: BookingStatus)\n            +validateTicketLimit(): void\n            +confirm(): void\n            +cancel(): void\n        }\n\n        class Payment {\n            -bookingId: Long\n            -amount: BigDecimal\n            -method: PaymentMethod\n            -status: PaymentStatus\n            +Payment(id: Long, bookingId: Long, amount: BigDecimal, method: PaymentMethod, status: PaymentStatus)\n            +markSuccess(): void\n            +markFailed(): void\n        }\n\n        class Ticket {\n            -bookingId: Long\n            -matchId: Long\n            -seatId: Long\n            -ticketCode: String\n            -status: TicketStatus\n            -checkedInAt: LocalDateTime\n            +Ticket(id: Long, bookingId: Long, matchId: Long, seatId: Long, ticketCode: String, status: TicketStatus)\n            +issue(): void\n            +isValidForMatch(matchId: Long): boolean\n            +checkIn(time: LocalDateTime): void\n            +cancel(): void\n        }\n\n        class BookingTransaction {\n            -simulationId: Long\n            -bookingId: Long\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            -mechanism: SyncMechanism\n            -status: TransactionStatus\n            -createdAt: LocalDateTime\n            -completedAt: LocalDateTime\n            -durationMillis: long\n            -failureReason: String\n            +BookingTransaction(id: Long, fanId: Long, matchId: Long, seatIds: List~Long~, mechanism: SyncMechanism)\n            +attachBooking(bookingId: Long): void\n            +attachSimulation(simulationId: Long): void\n            +markSuccessful(completedAt: LocalDateTime): void\n            +markFailed(reason: String, completedAt: LocalDateTime): void\n            +calculateDuration(): long\n        }\n\n        class BookingStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            PENDING\n            CONFIRMED\n            CANCELLED\n        }\n\n        class PaymentMethod {\n            &lt;&lt;enumeration&gt;&gt;\n            ONLINE\n            OFFLINE_CASH\n        }\n\n        class PaymentStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            PENDING\n            SUCCESS\n            FAILED\n        }\n\n        class TicketStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            PENDING\n            ISSUED\n            CHECKED_IN\n            CANCELLED\n        }\n\n        class Simulation {\n            -matchId: Long\n            -targetSeatIds: List~Long~\n            -threadCount: int\n            -mechanism: SyncMechanism\n            -status: SimulationStatus\n            +Simulation(id: Long, matchId: Long, targetSeatIds: List~Long~, threadCount: int, mechanism: SyncMechanism)\n            +start(): void\n            +complete(): void\n        }\n\n        class SimulationResult {\n            -simulationId: Long\n            -mechanism: SyncMechanism\n            -threadCount: int\n            -attemptCount: int\n            -successCount: int\n            -failedCount: int\n            -conflictCount: int\n            -doubleBookingCount: int\n            -durationMillis: long\n            +SimulationResult(id: Long, simulationId: Long, mechanism: SyncMechanism, threadCount: int)\n            +recordAttempt(success: boolean, conflict: boolean, doubleBooking: boolean): void\n            +calculateThroughput(): double\n            +calculateDoubleBookingRate(): double\n        }\n\n        class SyncMechanism {\n            &lt;&lt;enumeration&gt;&gt;\n            NO_LOCK\n            SYNCHRONIZED\n            FILE_LOCK\n            OPTIMISTIC\n        }\n\n        class SimulationStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            CONFIGURED\n            RUNNING\n            COMPLETED\n        }\n\n        class TransactionStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            SUCCESS\n            FAILED\n            CONFLICT\n        }\n\n    }\n\n    namespace EXCEPTIONS {\n        class EntityNotFoundException {\n            +EntityNotFoundException(message: String)\n        }\n\n        class InvalidBookingException {\n            +InvalidBookingException(message: String)\n        }\n\n        class SeatAlreadyBookedException {\n            +SeatAlreadyBookedException(message: String)\n        }\n\n        class PaymentFailedException {\n            +PaymentFailedException(message: String)\n        }\n\n        class CsvDataException {\n            +CsvDataException(message: String)\n        }\n\n        class OptimisticLockException {\n            +OptimisticLockException(message: String)\n        }\n\n        class RuntimeException {\n            +RuntimeException(message: String)\n        }\n\n    }\n\n    %% 1. Console entry and presentation routing\n    Main ..&gt; MainView : starts\n    MainView --&gt; AuthController : session\n    MainView --&gt; FanController : account\n    MainView --&gt; BrowseController : public browsing\n    MainView --&gt; BookingView : fan flow\n    MainView --&gt; SellerView : seller flow\n    MainView --&gt; GateView : gate flow\n    MainView --&gt; AdminManagementView : admin flow\n    MainView --&gt; SimulatorView : simulation flow\n    SeatMapView --&gt; BrowseController\n    BookingView --&gt; BookingController\n    BookingView --&gt; RefundController\n    SellerView --&gt; BookingController\n    SellerView --&gt; FanController\n    GateView --&gt; TicketController\n    AdminManagementView --&gt; StadiumController\n    AdminManagementView --&gt; MatchController\n    AdminManagementView --&gt; AccountAdminController\n    AdminManagementView --&gt; AdminController\n    AdminManagementView --&gt; RefundController\n    SimulatorView --&gt; SimulationController\n    ReportView --&gt; SimulationController\n\n    %% 2. Controller to repository and helper flow\n    AuthController --&gt; FanRepository\n    AuthController --&gt; StaffRepository\n    FanController --&gt; FanRepository\n    FanController --&gt; BookingRepository\n    FanController --&gt; TicketRepository\n    BrowseController --&gt; MatchRepository\n    BrowseController --&gt; MatchSeatRepository\n    StadiumController --&gt; StadiumRepository\n    StadiumController --&gt; SectionRepository\n    StadiumController --&gt; SeatRepository\n    MatchController --&gt; MatchRepository\n    MatchController --&gt; TicketPriceRepository\n    MatchController --&gt; MatchSeatRepository\n    AccountAdminController --&gt; FanRepository\n    AccountAdminController --&gt; StaffRepository\n    AdminController --&gt; DataGenerator\n    AdminController --&gt; FanRepository\n    AdminController --&gt; StaffRepository\n    AdminController --&gt; StadiumRepository\n    AdminController --&gt; MatchRepository\n    AdminController --&gt; BookingRepository\n    AdminController --&gt; TicketRepository\n    AdminController --&gt; AuditLogRepository\n    RefundController --&gt; RefundRepository\n    RefundController --&gt; BookingRepository\n    BookingController --&gt; BookingRepository\n    BookingController --&gt; TicketRepository\n    BookingController --&gt; PaymentRepository\n    BookingController --&gt; TransactionRepository\n    BookingController --&gt; SeatRepository\n    BookingController --&gt; TicketPriceRepository\n    BookingController --&gt; StrategyFactory\n    BookingController --&gt; MockPaymentService\n    TicketController --&gt; TicketRepository\n    SimulationController --&gt; SimulationRepository\n    SimulationController --&gt; SimulationResultRepository\n    SimulationController --&gt; StrategyFactory\n    SimulationController ..&gt; BookingTask\n\n    %% 3. Concurrency strategy flow\n    BookingTask --&gt; BookingStrategy\n    StrategyFactory --&gt; MatchSeatRepository\n    StrategyFactory --&gt; TransactionRepository\n    StrategyFactory ..&gt; BookingStrategy\n    BookingStrategy &lt;|.. NoLockStrategy\n    BookingStrategy &lt;|.. SynchronizedStrategy\n    BookingStrategy &lt;|.. FileLockStrategy\n    BookingStrategy &lt;|.. OptimisticLockStrategy\n    NoLockStrategy --&gt; MatchSeatRepository\n    NoLockStrategy --&gt; TransactionRepository\n    SynchronizedStrategy --&gt; MatchSeatRepository\n    SynchronizedStrategy --&gt; TransactionRepository\n    FileLockStrategy --&gt; MatchSeatRepository\n    FileLockStrategy --&gt; TransactionRepository\n    OptimisticLockStrategy --&gt; MatchSeatRepository\n    OptimisticLockStrategy --&gt; TransactionRepository\n\n    %% 4. Generic CSV repository hierarchy\n    FanRepository --|&gt; CsvRepository~T~\n    StaffRepository --|&gt; CsvRepository~T~\n    StadiumRepository --|&gt; CsvRepository~T~\n    SectionRepository --|&gt; CsvRepository~T~\n    SeatRepository --|&gt; CsvRepository~T~\n    MatchRepository --|&gt; CsvRepository~T~\n    BookingRepository --|&gt; CsvRepository~T~\n    PaymentRepository --|&gt; CsvRepository~T~\n    TicketRepository --|&gt; CsvRepository~T~\n    TransactionRepository --|&gt; CsvRepository~T~\n    SimulationRepository --|&gt; CsvRepository~T~\n    SimulationResultRepository --|&gt; CsvRepository~T~\n    RefundRepository --|&gt; CsvRepository~T~\n    AuditLogRepository --|&gt; CsvRepository~T~\n    DataGenerator ..&gt; CsvRepository~T~\n\n    %% 5. Entity inheritance and business relationships\n    User --|&gt; BaseEntity\n    Fan --|&gt; User\n    Staff --|&gt; User\n    Stadium --|&gt; BaseEntity\n    Section --|&gt; BaseEntity\n    Seat --|&gt; BaseEntity\n    Match --|&gt; BaseEntity\n    Booking --|&gt; BaseEntity\n    Payment --|&gt; BaseEntity\n    Ticket --|&gt; BaseEntity\n    BookingTransaction --|&gt; BaseEntity\n    RefundRequest --|&gt; BaseEntity\n    AuditLog --|&gt; BaseEntity\n    Simulation --|&gt; BaseEntity\n    SimulationResult --|&gt; BaseEntity\n    Stadium \&quot;1\&quot; *-- \&quot;0..*\&quot; Section\n    Section \&quot;1\&quot; *-- \&quot;0..*\&quot; Seat\n    Match \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Stadium\n    Match \&quot;1\&quot; *-- \&quot;0..*\&quot; MatchSeat\n    MatchSeat \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Seat\n    TicketPrice \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Match\n    TicketPrice \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Section\n    Booking \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Fan\n    Booking \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Match\n    Booking \&quot;0..1\&quot; --&gt; \&quot;1..4\&quot; MatchSeat\n    Booking \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Payment\n    Booking \&quot;1\&quot; *-- \&quot;0..4\&quot; Ticket\n    Booking \&quot;0..1\&quot; --&gt; \&quot;1..*\&quot; BookingTransaction\n    RefundRequest \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Booking\n    RefundRequest \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Fan\n    RefundRequest \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Staff\n    Ticket \&quot;0..1\&quot; --&gt; \&quot;1\&quot; MatchSeat\n    AuditLog \&quot;0..*\&quot; --&gt; \&quot;1\&quot; User\n    Simulation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Match\n    Simulation \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SimulationResult\n    Simulation \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BookingTransaction\n\n    %% 6. Exception hierarchy\n    RuntimeException &lt;|-- EntityNotFoundException\n    RuntimeException &lt;|-- InvalidBookingException\n    RuntimeException &lt;|-- SeatAlreadyBookedException\n    RuntimeException &lt;|-- PaymentFailedException\n    RuntimeException &lt;|-- CsvDataException\n    RuntimeException &lt;|-- OptimisticLockException\n\n    note for MainView \&quot;START: authenticate, select role menu, then route to a domain view\&quot;\n    note for BookingController \&quot;BOOKING: validate 1-4 seats, calculate price, reserve seats, record payment, issue tickets\&quot;\n    note for SimulationController \&quot;SIMULATION: configure, synchronize threads, execute strategy, calculate metrics, export results\&quot;\n    note for BaseEntity \&quot;CSV entities share id and serialization contracts\&quot;\n\n    classDef view fill:#eef6ff,stroke:#3b82f6,color:#102a43,stroke-width:1px\n    classDef controller fill:#edfcf3,stroke:#22a06b,color:#102a43,stroke-width:1px\n    classDef repository fill:#fff7e8,stroke:#d97706,color:#102a43,stroke-width:1px\n    classDef model fill:#f7f0ff,stroke:#845ec2,color:#102a43,stroke-width:1px\n    classDef helper fill:#f1f5f9,stroke:#64748b,color:#102a43,stroke-width:1px\n    class Main view\n    class MainView view\n    class AdminManagementView view\n    class SeatMapView view\n    class BookingView view\n    class SellerView view\n    class GateView view\n    class SimulatorView view\n    class ReportView view\n    class AuthController controller\n    class FanController controller\n    class BrowseController controller\n    class StadiumController controller\n    class MatchController controller\n    class AccountAdminController controller\n    class AdminController controller\n    class RefundController controller\n    class BookingController controller\n    class TicketController controller\n    class SimulationController controller\n    class FanRepository repository\n    class StaffRepository repository\n    class BookingRepository repository\n    class MatchRepository repository\n    class MatchSeatRepository repository\n    class TicketRepository repository\n    class StadiumRepository repository\n    class SectionRepository repository\n    class SeatRepository repository\n    class TicketPriceRepository repository\n    class RefundRepository repository\n    class AuditLogRepository repository\n    class PaymentRepository repository\n    class TransactionRepository repository\n    class SimulationRepository repository\n    class SimulationResultRepository repository\n    class DataGenerator repository\n    class BookingStrategy helper\n    class StrategyFactory helper\n    class MockPaymentService helper\n    class NoLockStrategy helper\n    class SynchronizedStrategy helper\n    class FileLockStrategy helper\n    class OptimisticLockStrategy helper\n    class BookingTask helper\n    class BaseEntity model\n    class User model\n    class Fan model\n    class Staff model\n    class Match model\n    class MatchSeat model\n    class UserRole model\n    class UserStatus model\n    class Stadium model\n    class Section model\n    class Seat model\n    class TicketPrice model\n    class SaleStatus model\n    class SeatStatus model\n    class RefundRequest model\n    class RefundStatus model\n    class AuditLog model\n    class SystemSummary model\n    class BookingRequest model\n    class BookingResponse model\n    class Booking model\n    class Payment model\n    class Ticket model\n    class BookingTransaction model\n    class BookingStatus model\n    class PaymentMethod model\n    class PaymentStatus model\n    class TicketStatus model\n    class Simulation model\n    class SimulationResult model\n    class SyncMechanism model\n    class SimulationStatus model\n    class TransactionStatus model\n    class EntityNotFoundException helper\n    class InvalidBookingException helper\n    class SeatAlreadyBookedException helper\n    class PaymentFailedException helper\n    class CsvDataException helper\n    class OptimisticLockException helper\n    class RuntimeException helper&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UeA4yCj5cc-5vu4OfIJV-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
