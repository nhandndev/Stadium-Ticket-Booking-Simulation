  <diagram id="QCmMsdIUcZfzpFGQnxpv" name="02_Stadium_Match_Admin">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    namespace VIEW {\n        class AdminManagementView {\n            -stadiumController: StadiumController\n            -matchController: MatchController\n            -accountAdminController: AccountAdminController\n            -adminController: AdminController\n            -refundController: RefundController\n            +AdminManagementView(stadiumController: StadiumController, matchController: MatchController, accountAdminController: AccountAdminController, adminController: AdminController, refundController: RefundController)\n            +showStadiumMenu(): void\n            +showMatchMenu(): void\n            +showFanManagementMenu(): void\n            +showStaffManagementMenu(): void\n            +showRefundReviewMenu(): void\n            +showSystemSummary(): void\n            +showAuditLogs(): void\n            +showDataGenerationMenu(): void\n        }\n\n    }\n\n    namespace CONTROLLER {\n        class StadiumController {\n            -stadiumRepository: StadiumRepository\n            -sectionRepository: SectionRepository\n            -seatRepository: SeatRepository\n            +StadiumController(stadiumRepository: StadiumRepository, sectionRepository: SectionRepository, seatRepository: SeatRepository)\n            +createStadium(name: String, address: String): Stadium\n            +getStadiums(): List~Stadium~\n            +getStadiumDetails(stadiumId: Long): Stadium\n            +updateStadium(stadiumId: Long, name: String, address: String): Stadium\n            +deleteStadium(stadiumId: Long): boolean\n            +createSection(stadiumId: Long, name: String): Section\n            +getSections(stadiumId: Long): List~Section~\n            +getSectionDetails(sectionId: Long): Section\n            +updateSection(sectionId: Long, name: String): Section\n            +deleteSection(sectionId: Long): boolean\n            +createSeat(sectionId: Long, rowLabel: String, seatNumber: int): Seat\n            +buildSeatMap(sectionId: Long): List~Seat~\n            +getSeatDetails(seatId: Long): Seat\n            +updateSeat(seatId: Long, rowLabel: String, seatNumber: int): Seat\n            +deleteSeat(seatId: Long): boolean\n            +activateSeat(seatId: Long): Seat\n            +deactivateSeat(seatId: Long): Seat\n        }\n\n        class MatchController {\n            -matchRepository: MatchRepository\n            -ticketPriceRepository: TicketPriceRepository\n            -matchSeatRepository: MatchSeatRepository\n            +MatchController(matchRepository: MatchRepository, ticketPriceRepository: TicketPriceRepository, matchSeatRepository: MatchSeatRepository)\n            +createMatch(stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime): Match\n            +getMatches(): List~Match~\n            +getMatchDetails(matchId: Long): Match\n            +updateMatch(match: Match): Match\n            +deleteMatch(matchId: Long): boolean\n            +createTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice\n            +getTicketPrices(matchId: Long): List~TicketPrice~\n            +getTicketPriceDetails(matchId: Long, sectionId: Long): TicketPrice\n            +updateTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice\n            +deleteTicketPrice(matchId: Long, sectionId: Long): boolean\n            +openTicketSales(matchId: Long): Match\n            +closeTicketSales(matchId: Long): Match\n            +getTicketSalesStatus(matchId: Long): SaleStatus\n        }\n\n        class AccountAdminController {\n            -fanRepository: FanRepository\n            -staffRepository: StaffRepository\n            +AccountAdminController(fanRepository: FanRepository, staffRepository: StaffRepository)\n            +createFanAccount(fullName: String, email: String, password: String, phone: String): Fan\n            +getFans(): List~Fan~\n            +getFanDetails(fanId: Long): Fan\n            +searchFans(keyword: String): List~Fan~\n            +filterFans(status: UserStatus): List~Fan~\n            +updateFan(fanId: Long, fullName: String, phone: String): Fan\n            +activateFan(fanId: Long): Fan\n            +deactivateFan(fanId: Long): Fan\n            +deleteFan(fanId: Long): boolean\n            +createStaffAccount(fullName: String, email: String, password: String, phone: String, role: UserRole): Staff\n            +getStaffs(): List~Staff~\n            +getStaffDetails(staffId: Long): Staff\n            +searchStaff(keyword: String): List~Staff~\n            +filterStaff(role: UserRole, status: UserStatus): List~Staff~\n            +updateStaff(staffId: Long, fullName: String, phone: String): Staff\n            +activateStaff(staffId: Long): Staff\n            +deactivateStaff(staffId: Long): Staff\n            +assignRole(staffId: Long, role: UserRole): Staff\n            +changeRole(staffId: Long, role: UserRole): Staff\n            +revokeRole(staffId: Long): Staff\n        }\n\n        class AdminController {\n            -dataGenerator: DataGenerator\n            -fanRepository: FanRepository\n            -staffRepository: StaffRepository\n            -stadiumRepository: StadiumRepository\n            -matchRepository: MatchRepository\n            -bookingRepository: BookingRepository\n            -ticketRepository: TicketRepository\n            -auditLogRepository: AuditLogRepository\n            +AdminController(dataGenerator: DataGenerator, fanRepository: FanRepository, staffRepository: StaffRepository, stadiumRepository: StadiumRepository, matchRepository: MatchRepository, bookingRepository: BookingRepository, ticketRepository: TicketRepository, auditLogRepository: AuditLogRepository)\n            +generateCsvDataset(recordCount: int): void\n            +getSystemSummary(): SystemSummary\n            +getAuditLogs(): List~AuditLog~\n        }\n\n        class RefundController {\n            -refundRepository: RefundRepository\n            -bookingRepository: BookingRepository\n            +RefundController(refundRepository: RefundRepository, bookingRepository: BookingRepository)\n            +requestRefund(fanId: Long, bookingId: Long, reason: String): RefundRequest\n            +reviewRefund(adminId: Long, requestId: Long, approve: boolean, note: String): RefundRequest\n        }\n\n    }\n\n    namespace REPOSITORY {\n        class StadiumRepository {\n            +StadiumRepository(filePath: Path)\n            +findByName(name: String): List~Stadium~\n            #parseLine(line: String): Stadium\n        }\n\n        class SectionRepository {\n            +SectionRepository(filePath: Path)\n            +findByStadiumId(stadiumId: Long): List~Section~\n            #parseLine(line: String): Section\n        }\n\n        class SeatRepository {\n            +SeatRepository(filePath: Path)\n            +findBySectionId(sectionId: Long): List~Seat~\n            #parseLine(line: String): Seat\n        }\n\n        class MatchRepository {\n            +MatchRepository(filePath: Path)\n            +findUpcoming(): List~Match~\n            #parseLine(line: String): Match\n        }\n\n        class TicketPriceRepository {\n            -filePath: Path\n            +TicketPriceRepository(filePath: Path)\n            +findPrice(matchId: Long, sectionId: Long): TicketPrice\n            +findByMatchId(matchId: Long): List~TicketPrice~\n            +save(price: TicketPrice): TicketPrice\n            +update(price: TicketPrice): TicketPrice\n            +delete(matchId: Long, sectionId: Long): boolean\n        }\n\n        class MatchSeatRepository {\n            -filePath: Path\n            +MatchSeatRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~MatchSeat~\n            +find(matchId: Long, seatId: Long): MatchSeat\n            +save(seat: MatchSeat): MatchSeat\n            +updateWithoutLock(seat: MatchSeat): boolean\n            +updateSynchronized(seat: MatchSeat): boolean\n            +updateWithFileLock(seat: MatchSeat): boolean\n            +updateIfVersionMatches(seat: MatchSeat, expectedVersion: int): boolean\n        }\n\n        class FanRepository {\n            +FanRepository(filePath: Path)\n            +findByEmail(email: String): Fan\n            +search(keyword: String): List~Fan~\n            #parseLine(line: String): Fan\n        }\n\n        class StaffRepository {\n            +StaffRepository(filePath: Path)\n            +findByEmail(email: String): Staff\n            +search(keyword: String): List~Staff~\n            #parseLine(line: String): Staff\n        }\n\n        class RefundRepository {\n            +RefundRepository(filePath: Path)\n            +findByFanId(fanId: Long): List~RefundRequest~\n            +findPending(): List~RefundRequest~\n            #parseLine(line: String): RefundRequest\n        }\n\n        class AuditLogRepository {\n            +AuditLogRepository(filePath: Path)\n            +append(log: AuditLog): void\n            +findRecent(limit: int): List~AuditLog~\n            #parseLine(line: String): AuditLog\n        }\n\n    }\n\n    namespace MODEL {\n        class Stadium {\n            -name: String\n            -address: String\n            +Stadium(id: Long, name: String, address: String)\n            +updateDetails(name: String, address: String): void\n        }\n\n        class Section {\n            -stadiumId: Long\n            -name: String\n            +Section(id: Long, stadiumId: Long, name: String)\n            +rename(name: String): void\n        }\n\n        class Seat {\n            -sectionId: Long\n            -rowLabel: String\n            -seatNumber: int\n            -active: boolean\n            +Seat(id: Long, sectionId: Long, rowLabel: String, seatNumber: int, active: boolean)\n            +updateLocation(rowLabel: String, seatNumber: int): void\n            +activate(): void\n            +deactivate(): void\n        }\n\n        class Match {\n            -stadiumId: Long\n            -homeTeam: String\n            -awayTeam: String\n            -startTime: LocalDateTime\n            -saleStatus: SaleStatus\n            +Match(id: Long, stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime, saleStatus: SaleStatus)\n            +reschedule(startTime: LocalDateTime): void\n            +changeSaleStatus(status: SaleStatus): void\n        }\n\n        class MatchSeat {\n            -matchId: Long\n            -seatId: Long\n            -status: SeatStatus\n            -version: int\n            +MatchSeat(matchId: Long, seatId: Long, status: SeatStatus, version: int)\n            +isAvailable(): boolean\n            +lock(): void\n            +markBooked(): void\n            +release(): void\n        }\n\n        class TicketPrice {\n            -matchId: Long\n            -sectionId: Long\n            -amount: BigDecimal\n            +TicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal)\n            +updatePrice(amount: BigDecimal): void\n        }\n\n        class Fan {\n            -MAX_TICKETS_PER_TRANSACTION: int = 4\n            +Fan(id: Long, fullName: String, email: String, passwordHash: String, phone: String, status: UserStatus)\n            +canBook(ticketCount: int): boolean\n        }\n\n        class Staff {\n            +Staff(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)\n            +assignRole(role: UserRole): void\n        }\n\n        class UserRole {\n            &lt;&lt;enumeration&gt;&gt;\n            FAN\n            SELLER\n            GATE_STAFF\n            ADMIN\n            SIMULATOR_OPERATOR\n        }\n\n        class UserStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            ACTIVE\n            INACTIVE\n        }\n\n        class SaleStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            CLOSED\n            OPEN\n        }\n\n        class SeatStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            AVAILABLE\n            LOCKED\n            BOOKED\n        }\n\n        class RefundRequest {\n            -bookingId: Long\n            -fanId: Long\n            -reason: String\n            -status: RefundStatus\n            -requestedAt: LocalDateTime\n            -reviewedBy: Long\n            -reviewedAt: LocalDateTime\n            -reviewNote: String\n            +RefundRequest(id: Long, bookingId: Long, fanId: Long, reason: String, requestedAt: LocalDateTime)\n            +approve(adminId: Long, note: String, time: LocalDateTime): void\n            +reject(adminId: Long, note: String, time: LocalDateTime): void\n        }\n\n        class RefundStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            REQUESTED\n            APPROVED\n            REJECTED\n        }\n\n        class AuditLog {\n            -actorId: Long\n            -action: String\n            -targetType: String\n            -targetId: Long\n            -result: String\n            -createdAt: LocalDateTime\n            +AuditLog(id: Long, actorId: Long, action: String, targetType: String, targetId: Long, result: String, createdAt: LocalDateTime)\n            +toCsvLine(): String\n        }\n\n        class SystemSummary {\n            -fanCount: int\n            -staffCount: int\n            -stadiumCount: int\n            -matchCount: int\n            -bookingCount: int\n            -ticketCount: int\n            +SystemSummary(fanCount: int, staffCount: int, stadiumCount: int, matchCount: int, bookingCount: int, ticketCount: int)\n            +getTotalAccounts(): int\n        }\n\n    }\n\n    AdminManagementView --&gt; StadiumController\n    AdminManagementView --&gt; MatchController\n    AdminManagementView --&gt; AccountAdminController\n    AdminManagementView --&gt; AdminController\n    AdminManagementView --&gt; RefundController\n    StadiumController --&gt; StadiumRepository\n    MatchController --&gt; MatchRepository\n    AccountAdminController --&gt; FanRepository\n    AccountAdminController --&gt; StaffRepository\n    AdminController --&gt; AuditLogRepository\n    Stadium \&quot;1\&quot; *-- \&quot;0..*\&quot; Section\n    Section \&quot;1\&quot; *-- \&quot;0..*\&quot; Seat\n    Match \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Stadium\n    Match \&quot;1\&quot; *-- \&quot;0..*\&quot; MatchSeat\n    MatchSeat \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Seat\n    TicketPrice \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Match\n\n    classDef view fill:#eef6ff,stroke:#3b82f6,color:#102a43,stroke-width:1px\n    classDef controller fill:#edfcf3,stroke:#22a06b,color:#102a43,stroke-width:1px\n    classDef repository fill:#fff7e8,stroke:#d97706,color:#102a43,stroke-width:1px\n    classDef model fill:#f7f0ff,stroke:#845ec2,color:#102a43,stroke-width:1px\n    classDef helper fill:#f1f5f9,stroke:#64748b,color:#102a43,stroke-width:1px\n    class AdminManagementView view\n    class StadiumController controller\n    class MatchController controller\n    class AccountAdminController controller\n    class AdminController controller\n    class RefundController controller\n    class StadiumRepository repository\n    class SectionRepository repository\n    class SeatRepository repository\n    class MatchRepository repository\n    class TicketPriceRepository repository\n    class MatchSeatRepository repository\n    class FanRepository repository\n    class StaffRepository repository\n    class RefundRepository repository\n    class AuditLogRepository repository\n    class Stadium model\n    class Section model\n    class Seat model\n    class Match model\n    class MatchSeat model\n    class TicketPrice model\n    class Fan model\n    class Staff model\n    class UserRole model\n    class UserStatus model\n    class SaleStatus model\n    class SeatStatus model\n    class RefundRequest model\n    class RefundStatus model\n    class AuditLog model\n    class SystemSummary model&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KdBd0FS3f0e299MD9Hrt-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="VIEW" mermaidId="n:VIEW" mermaidBaseStyle="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="VIEW" id="KdBd0FS3f0e299MD9Hrt-2">
