  <diagram id="WdJ6oDC9c2_rbMbBcYeo" name="04_Simulation">
    <mxGraphModel dx="7030" dy="3960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    namespace VIEW {\n        class SimulatorView {\n            -simulationController: SimulationController\n            +SimulatorView(simulationController: SimulationController)\n            +showConfigurationMenu(): void\n            +startSimulation(simulationId: Long): void\n        }\n\n        class ReportView {\n            -simulationController: SimulationController\n            +ReportView(simulationController: SimulationController)\n            +displayResults(): void\n            +displayComparison(results: List~SimulationResult~): void\n            +exportResult(simulationId: Long, filePath: Path): void\n        }\n\n    }\n\n    namespace CONTROLLER {\n        class SimulationController {\n            -executor: ExecutorService\n            -strategyFactory: StrategyFactory\n            -simulationRepository: SimulationRepository\n            -resultRepository: SimulationResultRepository\n            +SimulationController(strategyFactory: StrategyFactory, simulationRepository: SimulationRepository, resultRepository: SimulationResultRepository)\n            +configureSimulation(matchId: Long, targetSeatIds: List~Long~, threadCount: int, mechanism: SyncMechanism): Simulation\n            +runSimulation(simulationId: Long): SimulationResult\n            +compareSyncMechanisms(simulationId: Long): List~SimulationResult~\n            +getResults(): List~SimulationResult~\n            +exportResult(simulationId: Long, filePath: Path): boolean\n            +shutdown(): void\n        }\n\n    }\n\n    namespace REPOSITORY {\n        class SimulationRepository {\n            +SimulationRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~Simulation~\n            #parseLine(line: String): Simulation\n        }\n\n        class SimulationResultRepository {\n            +SimulationResultRepository(filePath: Path)\n            +findBySimulationId(simulationId: Long): List~SimulationResult~\n            +exportResult(simulationId: Long, filePath: Path): boolean\n            #parseLine(line: String): SimulationResult\n        }\n\n        class MatchSeatRepository {\n            -filePath: Path\n            +MatchSeatRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~MatchSeat~\n            +find(matchId: Long, seatId: Long): MatchSeat\n            +save(seat: MatchSeat): MatchSeat\n            +updateWithoutLock(seat: MatchSeat): boolean\n            +updateSynchronized(seat: MatchSeat): boolean\n            +updateWithFileLock(seat: MatchSeat): boolean\n            +updateIfVersionMatches(seat: MatchSeat, expectedVersion: int): boolean\n        }\n\n        class TransactionRepository {\n            +TransactionRepository(filePath: Path)\n            +findBySimulationId(simulationId: Long): List~BookingTransaction~\n            #parseLine(line: String): BookingTransaction\n        }\n\n    }\n\n    namespace STRATEGY {\n        class BookingStrategy {\n            &lt;&lt;interface&gt;&gt;\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class NoLockStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +NoLockStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class SynchronizedStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +SynchronizedStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class FileLockStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +FileLockStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class OptimisticLockStrategy {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            -maxRetries: int\n            +OptimisticLockStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository, maxRetries: int)\n            +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction\n        }\n\n        class StrategyFactory {\n            -matchSeatRepository: MatchSeatRepository\n            -transactionRepository: TransactionRepository\n            +StrategyFactory(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)\n            +create(mechanism: SyncMechanism): BookingStrategy\n        }\n\n        class BookingTask {\n            -startLatch: CountDownLatch\n            -strategy: BookingStrategy\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            +BookingTask(startLatch: CountDownLatch, strategy: BookingStrategy, fanId: Long, matchId: Long, seatIds: List~Long~)\n            +call(): BookingTransaction\n        }\n\n    }\n\n    namespace MODEL {\n        class Simulation {\n            -matchId: Long\n            -targetSeatIds: List~Long~\n            -threadCount: int\n            -mechanism: SyncMechanism\n            -status: SimulationStatus\n            +Simulation(id: Long, matchId: Long, targetSeatIds: List~Long~, threadCount: int, mechanism: SyncMechanism)\n            +start(): void\n            +complete(): void\n        }\n\n        class SimulationResult {\n            -simulationId: Long\n            -mechanism: SyncMechanism\n            -threadCount: int\n            -attemptCount: int\n            -successCount: int\n            -failedCount: int\n            -conflictCount: int\n            -doubleBookingCount: int\n            -durationMillis: long\n            +SimulationResult(id: Long, simulationId: Long, mechanism: SyncMechanism, threadCount: int)\n            +recordAttempt(success: boolean, conflict: boolean, doubleBooking: boolean): void\n            +calculateThroughput(): double\n            +calculateDoubleBookingRate(): double\n        }\n\n        class BookingTransaction {\n            -simulationId: Long\n            -bookingId: Long\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            -mechanism: SyncMechanism\n            -status: TransactionStatus\n            -createdAt: LocalDateTime\n            -completedAt: LocalDateTime\n            -durationMillis: long\n            -failureReason: String\n            +BookingTransaction(id: Long, fanId: Long, matchId: Long, seatIds: List~Long~, mechanism: SyncMechanism)\n            +attachBooking(bookingId: Long): void\n            +attachSimulation(simulationId: Long): void\n            +markSuccessful(completedAt: LocalDateTime): void\n            +markFailed(reason: String, completedAt: LocalDateTime): void\n            +calculateDuration(): long\n        }\n\n        class MatchSeat {\n            -matchId: Long\n            -seatId: Long\n            -status: SeatStatus\n            -version: int\n            +MatchSeat(matchId: Long, seatId: Long, status: SeatStatus, version: int)\n            +isAvailable(): boolean\n            +lock(): void\n            +markBooked(): void\n            +release(): void\n        }\n\n        class SyncMechanism {\n            &lt;&lt;enumeration&gt;&gt;\n            NO_LOCK\n            SYNCHRONIZED\n            FILE_LOCK\n            OPTIMISTIC\n        }\n\n        class SimulationStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            CONFIGURED\n            RUNNING\n            COMPLETED\n        }\n\n        class TransactionStatus {\n            &lt;&lt;enumeration&gt;&gt;\n            SUCCESS\n            FAILED\n            CONFLICT\n        }\n\n    }\n\n    SimulatorView --&gt; SimulationController\n    ReportView --&gt; SimulationController\n    SimulationController --&gt; SimulationRepository\n    SimulationController --&gt; SimulationResultRepository\n    SimulationController --&gt; StrategyFactory\n    SimulationController ..&gt; BookingTask\n    BookingTask --&gt; BookingStrategy\n    BookingStrategy &lt;|.. NoLockStrategy\n    BookingStrategy &lt;|.. SynchronizedStrategy\n    BookingStrategy &lt;|.. FileLockStrategy\n    BookingStrategy &lt;|.. OptimisticLockStrategy\n    StrategyFactory ..&gt; BookingStrategy\n    Simulation \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SimulationResult\n    Simulation \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BookingTransaction\n\n    classDef view fill:#eef6ff,stroke:#3b82f6,color:#102a43,stroke-width:1px\n    classDef controller fill:#edfcf3,stroke:#22a06b,color:#102a43,stroke-width:1px\n    classDef repository fill:#fff7e8,stroke:#d97706,color:#102a43,stroke-width:1px\n    classDef model fill:#f7f0ff,stroke:#845ec2,color:#102a43,stroke-width:1px\n    classDef helper fill:#f1f5f9,stroke:#64748b,color:#102a43,stroke-width:1px\n    class SimulatorView view\n    class ReportView view\n    class SimulationController controller\n    class SimulationRepository repository\n    class SimulationResultRepository repository\n    class MatchSeatRepository repository\n    class TransactionRepository repository\n    class BookingStrategy helper\n    class NoLockStrategy helper\n    class SynchronizedStrategy helper\n    class FileLockStrategy helper\n    class OptimisticLockStrategy helper\n    class StrategyFactory helper\n    class BookingTask helper\n    class Simulation model\n    class SimulationResult model\n    class BookingTransaction model\n    class MatchSeat model\n    class SyncMechanism model\n    class SimulationStatus model\n    class TransactionStatus model&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="99rPUddeQZB_7rd130rq-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
