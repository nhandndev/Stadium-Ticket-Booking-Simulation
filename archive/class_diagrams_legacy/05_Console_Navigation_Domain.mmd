classDiagram
direction TB

namespace View {
  class MainView {
    -consoleUI: ConsoleUI
    +MainView(consoleUI: ConsoleUI)
    +main(args: String[]): void
    +start(): void
  }
  class ConsoleUI {
    -guestMenu: GuestMenu
    -userMenu: UserMenu
    -adminMenu: AdminMenu
    -currentUser: User
    +ConsoleUI(guestMenu: GuestMenu, userMenu: UserMenu, adminMenu: AdminMenu)
    +run(): void
    +showGuestMenu(): void
    +openRoleMenu(user: User): void
    +logout(): void
    -readChoice(): int
    -showMessage(message: String): void
  }
  class GuestMenu {
    -fanController: FanController
    -stadiumController: StadiumController
    +GuestMenu(fanController: FanController, stadiumController: StadiumController)
    +showMenu(): void
    +searchMatches(): void
    +viewMatchDetails(): void
    +viewSeatAvailability(): void
    +register(): void
    +login(): User
  }
  class UserMenu {
    -fanController: FanController
    -stadiumController: StadiumController
    -bookingController: BookingController
    -currentUser: User
    +UserMenu(fanController: FanController, stadiumController: StadiumController, bookingController: BookingController)
    +setCurrentUser(user: User): void
    +showMenu(): void
    +updateProfile(): void
    +selectSeats(): void
    +createBooking(): void
    +makeOnlinePayment(): void
    +viewBookings(): void
    +viewBookingDetail(): void
    +viewTickets(): void
    +viewTicketDetail(): void
  }
  class AdminMenu {
    -fanController: FanController
    -stadiumController: StadiumController
    -simulationController: SimulationController
    -currentAdmin: User
    +AdminMenu(fanController: FanController, stadiumController: StadiumController, simulationController: SimulationController)
    +setCurrentAdmin(admin: User): void
    +showMenu(): void
    +manageStadiums(): void
    +manageSections(): void
    +manageSeats(): void
    +manageMatches(): void
    +manageTicketPrices(): void
    +manageTicketSales(): void
    +manageUsers(): void
    +generateCsvDataset(): void
    +configureSimulation(): void
    +runSimulation(): void
    +viewSimulationResults(): void
    +compareSyncMechanisms(): void
  }
  class SeatMapView {
    +displaySeatMap(seats: List~MatchSeat~): void
    +displaySeatLegend(): void
    +readSelectedSeatIds(): List~Long~
  }
  class BookingView {
    +displayBooking(booking: Booking): void
    +displayTickets(tickets: List~Ticket~): void
    +displayBookingError(message: String): void
  }
  class SimulatorView {
    +readSimulationConfig(): Simulation
    +displayProgress(completed: int, total: int): void
    +displayComparison(results: List~SimulationResult~): void
  }
  class ReportView {
    +displaySystemSummary(): void
    +displaySimulationResult(result: SimulationResult): void
  }
}

namespace Required_Controllers {
  class FanController {
    -userService: UserService
    +FanController(userService: UserService)
    +register(fullName: String, email: String, password: String): Fan
    +login(email: String, password: String): User
    +logout(): void
    +updateProfile(fullName: String, phone: String): User
    +getCurrentUser(): User
    +getFans(): List~Fan~
    +createFanAccount(fullName: String, email: String): Fan
    +updateFanAccount(fanId: Long, fullName: String, phone: String): Fan
    +deactivateFanAccount(fanId: Long): Fan
    +deleteFanAccount(fanId: Long): boolean
  }
  class StadiumController {
    -stadiumService: StadiumService
    +StadiumController(stadiumService: StadiumService)
    +searchMatches(keyword: String): List~Match~
    +getMatchDetails(matchId: Long): Match
    +getSeatAvailability(matchId: Long): List~MatchSeat~
    +getStadiums(): List~Stadium~
    +getSections(stadiumId: Long): List~Section~
    +getSeats(sectionId: Long): List~Seat~
    +createStadium(name: String, address: String): Stadium
    +updateStadium(stadiumId: Long, name: String, address: String): Stadium
    +deleteStadium(stadiumId: Long): void
    +createSection(stadiumId: Long, name: String): Section
    +updateSection(sectionId: Long, name: String): Section
    +deleteSection(sectionId: Long): void
    +createSeat(sectionId: Long, rowLabel: String, seatNumber: int): Seat
    +updateSeat(seatId: Long, rowLabel: String, seatNumber: int): Seat
    +deleteSeat(seatId: Long): void
    +createMatch(stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime): Match
    +updateMatch(matchId: Long, startTime: LocalDateTime): Match
    +deleteMatch(matchId: Long): void
    +setTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice
    +openTicketSales(matchId: Long): Match
    +closeTicketSales(matchId: Long): Match
  }
  class BookingController {
    -bookingService: BookingService
    -paymentService: PaymentService
    -ticketService: TicketService
    +BookingController(bookingService: BookingService, paymentService: PaymentService, ticketService: TicketService)
    +selectSeats(matchId: Long, seatIds: List~Long~): List~MatchSeat~
    +createBooking(fanId: Long, matchId: Long, seatIds: List~Long~): Booking
    +makeOnlinePayment(bookingId: Long): Payment
    +getBookings(fanId: Long): List~Booking~
    +getBookingDetail(bookingId: Long): Booking
    +getTickets(fanId: Long): List~Ticket~
    +getTicketDetail(ticketId: Long): Ticket
  }
  class SimulationController {
    -simulationService: SimulationService
    +SimulationController(simulationService: SimulationService)
    +generateCsvDataset(recordCount: int): void
    +configureSimulation(matchId: Long, targetSeatIds: List~Long~, concurrentUsers: int, mechanism: SyncMechanism): Simulation
    +runSimulation(simulationId: Long): SimulationResult
    +getSimulationResult(simulationId: Long): SimulationResult
    +compareSyncMechanisms(matchId: Long, concurrentUsers: int): List~SimulationResult~
    +shutdown(): void
  }
}

namespace Required_Services {
  class UserService {
    -fanRepository: FanRepository
    -currentUser: User
    +UserService(fanRepository: FanRepository)
    +register(fullName: String, email: String, password: String): Fan
    +login(email: String, password: String): User
    +logout(): void
    +updateProfile(fullName: String, phone: String): User
    +getCurrentUser(): User
    +getFans(): List~Fan~
    +createFanAccount(fullName: String, email: String): Fan
    +updateFanAccount(fanId: Long, fullName: String, phone: String): Fan
    +deactivateFanAccount(fanId: Long): Fan
    +deleteFanAccount(fanId: Long): boolean
  }
  class StadiumService {
    -stadiumRepository: StadiumRepository
    -seatRepository: SeatRepository
    -matchRepository: MatchRepository
    +StadiumService(stadiumRepository: StadiumRepository, seatRepository: SeatRepository, matchRepository: MatchRepository)
    +searchMatches(keyword: String): List~Match~
    +getMatchDetails(matchId: Long): Match
    +getSeatAvailability(matchId: Long): List~MatchSeat~
    +getStadiums(): List~Stadium~
    +getSections(stadiumId: Long): List~Section~
    +getSeats(sectionId: Long): List~Seat~
    +createStadium(name: String, address: String): Stadium
    +updateStadium(stadiumId: Long, name: String, address: String): Stadium
    +deleteStadium(stadiumId: Long): void
    +createSection(stadiumId: Long, name: String): Section
    +updateSection(sectionId: Long, name: String): Section
    +deleteSection(sectionId: Long): void
    +createSeat(sectionId: Long, rowLabel: String, seatNumber: int): Seat
    +updateSeat(seatId: Long, rowLabel: String, seatNumber: int): Seat
    +deleteSeat(seatId: Long): void
    +createMatch(stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime): Match
    +updateMatch(matchId: Long, startTime: LocalDateTime): Match
    +deleteMatch(matchId: Long): void
    +setTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice
    +openTicketSales(matchId: Long): Match
    +closeTicketSales(matchId: Long): Match
  }
  class BookingService {
    -matchRepository: MatchRepository
    -bookingRepository: BookingRepository
    -transactionRepository: TransactionRepository
    +BookingService(matchRepository: MatchRepository, bookingRepository: BookingRepository, transactionRepository: TransactionRepository)
    +selectSeats(matchId: Long, seatIds: List~Long~): List~MatchSeat~
    +createBooking(fanId: Long, matchId: Long, seatIds: List~Long~): Booking
    +executeBookingCore(fanId: Long, matchId: Long, seatIds: List~Long~, mechanism: SyncMechanism): Booking
    +validateTicketLimit(seatIds: List~Long~): void
    +recordTransaction(booking: Booking, mechanism: SyncMechanism): BookingTransaction
    +getBookings(fanId: Long): List~Booking~
    +getBookingDetail(bookingId: Long): Booking
  }
  class PaymentService {
    -bookingRepository: BookingRepository
    -paymentRepository: PaymentRepository
    +PaymentService(bookingRepository: BookingRepository, paymentRepository: PaymentRepository)
    +makeOnlinePayment(bookingId: Long): Payment
    -simulatePayment(payment: Payment): boolean
  }
  class TicketService {
    -bookingRepository: BookingRepository
    -ticketRepository: TicketRepository
    +TicketService(bookingRepository: BookingRepository, ticketRepository: TicketRepository)
    +issueTickets(bookingId: Long): List~Ticket~
    +getTickets(fanId: Long): List~Ticket~
    +getTicketDetail(ticketId: Long): Ticket
  }
  class SimulationService {
    -simulationRepository: SimulationRepository
    -dataGenerator: DataGenerator
    -bookingService: BookingService
    -executor: ExecutorService
    -strategyFactory: StrategyFactory
    +SimulationService(simulationRepository: SimulationRepository, dataGenerator: DataGenerator, bookingService: BookingService, strategyFactory: StrategyFactory)
    +generateCsvDataset(recordCount: int): void
    +configureSimulation(matchId: Long, targetSeatIds: List~Long~, concurrentUsers: int, mechanism: SyncMechanism): Simulation
    +runSimulation(simulationId: Long): SimulationResult
    +getSimulationResult(simulationId: Long): SimulationResult
    +compareSyncMechanisms(matchId: Long, concurrentUsers: int): List~SimulationResult~
    +shutdown(): void
  }
}

