---
title: Concurrency Simulation Domain
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, Arial, sans-serif"
    primaryTextColor: "#172033"
    lineColor: "#64748B"
---
classDiagram
direction LR

namespace Simulation_Model {
  class Simulation {
    -id: Long
    -matchId: Long
    -targetSeatIds: List~Long~
    -concurrentUsers: int
    -syncMechanism: SyncMechanism
    -status: SimulationStatus
    +Simulation(id: Long, matchId: Long, targetSeatIds: List~Long~, concurrentUsers: int, syncMechanism: SyncMechanism, status: SimulationStatus)
    +start(): void
    +complete(): void
  }
  class SimulationResult {
    -simulationId: Long
    -mechanism: SyncMechanism
    -threadCount: int
    -attemptCount: int
    -successCount: int
    -failedCount: int
    -conflictCount: int
    -doubleBookingCount: int
    -durationMillis: long
    +SimulationResult(simulationId: Long, mechanism: SyncMechanism, threadCount: int, attemptCount: int, successCount: int, failedCount: int, conflictCount: int, doubleBookingCount: int, durationMillis: long)
    +calculateThroughput(): double
    +calculateDoubleBookingRate(): double
  }
  class SyncMechanism { <<enumeration>> NO_LOCK SYNCHRONIZED FILE_LOCK OPTIMISTIC }
  class SimulationStatus { <<enumeration>> CONFIGURED RUNNING COMPLETED }
}

namespace Required_Booking_Domain {
  class BookingController {
    -bookingService: BookingService
    +BookingController(bookingService: BookingService)
    +selectSeats(matchId: Long, seatIds: List~Long~): List~MatchSeat~
    +createBooking(fanId: Long, matchId: Long, seatIds: List~Long~): Booking
    +getBookings(fanId: Long): List~Booking~
    +getBookingDetail(bookingId: Long): Booking
  }
  class BookingService {
    -matchRepository: MatchRepository
    -bookingRepository: BookingRepository
    -transactionRepository: TransactionRepository
    +BookingService(matchRepository: MatchRepository, bookingRepository: BookingRepository, transactionRepository: TransactionRepository)
    +selectSeats(matchId: Long, seatIds: List~Long~): List~MatchSeat~
    +createBooking(fanId: Long, matchId: Long, seatIds: List~Long~): Booking
    +executeBookingCore(fanId: Long, matchId: Long, seatIds: List~Long~, mechanism: SyncMechanism): Booking
    +validateTicketLimit(seatIds: List~Long~): void
    +recordTransaction(booking: Booking, mechanism: SyncMechanism): BookingTransaction
  }
  class Booking {
    -id: Long
    -fanId: Long
    -matchId: Long
    -seatIds: List~Long~
    -totalAmount: BigDecimal
    -status: BookingStatus
    -createdAt: LocalDateTime
    +Booking(id: Long, fanId: Long, matchId: Long, seatIds: List~Long~, totalAmount: BigDecimal, createdAt: LocalDateTime)
    +validateTicketLimit(): void
    +confirm(): void
    +cancel(): void
    +isPayable(): boolean
  }
  class MatchSeat {
    -matchId: Long
    -seatId: Long
    -status: SeatStatus
    -version: int
    +MatchSeat(matchId: Long, seatId: Long)
    +isAvailable(): boolean
    +lock(expectedVersion: int): boolean
    +markBooked(expectedVersion: int): boolean
    +release(): void
  }
  class Payment {
    -id: Long
    -bookingId: Long
    -amount: BigDecimal
    -status: PaymentStatus
    -paidAt: LocalDateTime
    +Payment(id: Long, bookingId: Long, amount: BigDecimal)
    +markSuccessful(paidAt: LocalDateTime): void
    +markFailed(): void
  }
  class Ticket {
    -id: Long
    -bookingId: Long
    -matchId: Long
    -seatId: Long
    -ticketCode: String
    -issuedAt: LocalDateTime
    +Ticket(id: Long, bookingId: Long, matchId: Long, seatId: Long, ticketCode: String, issuedAt: LocalDateTime)
    +getTicketDetails(): String
  }
  class BookingTransaction {
    -id: Long
    -bookingId: Long
    -fanId: Long
    -matchId: Long
    -seatIds: List~Long~
    -mechanism: SyncMechanism
    -status: TransactionStatus
    -createdAt: LocalDateTime
    -completedAt: LocalDateTime
    -durationMillis: long
    -failureReason: String
    +BookingTransaction(id: Long, bookingId: Long, fanId: Long, matchId: Long, seatIds: List~Long~, mechanism: SyncMechanism)
    +markSuccessful(completedAt: LocalDateTime): void
    +markFailed(reason: String, completedAt: LocalDateTime): void
  }
  class BookingStatus { <<enumeration>> PENDING_PAYMENT CONFIRMED CANCELLED }
  class SeatStatus { <<enumeration>> AVAILABLE LOCKED BOOKED }
  class PaymentStatus { <<enumeration>> PENDING SUCCESS FAILED }
  class TransactionStatus { <<enumeration>> PENDING SUCCESS FAILED CONFLICT }
}

namespace Synchronization {
  class BookingStrategy {
    <<interface>>
    +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
  }
  class NoLockStrategy {
    -bookingService: BookingService
    +NoLockStrategy(bookingService: BookingService)
    +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
  }
  class SynchronizedStrategy {
    -bookingService: BookingService
    -monitor: Object
    +SynchronizedStrategy(bookingService: BookingService)
    +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
  }
  class FileLockStrategy {
    -bookingService: BookingService
    -lockFilePath: Path
    +FileLockStrategy(bookingService: BookingService, lockFilePath: Path)
    +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
  }
  class OptimisticLockStrategy {
    -bookingService: BookingService
    -maxRetries: int
    +OptimisticLockStrategy(bookingService: BookingService, maxRetries: int)
    +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
  }
  class BookingTask {
    -fanId: Long
    -matchId: Long
    -seatIds: List~Long~
    -startLatch: CountDownLatch
    -strategy: BookingStrategy
    +BookingTask(fanId: Long, matchId: Long, seatIds: List~Long~, startLatch: CountDownLatch, strategy: BookingStrategy)
    +call(): BookingTransaction
  }
  class StrategyFactory {
    +create(mechanism: SyncMechanism, bookingService: BookingService): BookingStrategy
  }
  class OptimisticLockException {
    +OptimisticLockException(message: String)
  }
}

namespace Repository {
  class CsvRepository~T~ {
    <<abstract>>
    #filePath: Path
    +CsvRepository(filePath: Path)
    +findAll(): List~T~
    +findById(id: Long): T
    +findByCondition(condition: Predicate~T~): List~T~
    +save(entity: T): T
    +update(entity: T): T
    +delete(id: Long): boolean
  }
  class SimulationRepository {
    -simulationFile: String
    -resultFile: String
    +SimulationRepository(dataDirectory: String)
    +findById(simulationId: Long): Simulation
    +save(simulation: Simulation): Simulation
    +update(simulation: Simulation): Simulation
    +findResult(simulationId: Long): SimulationResult
    +findAllResults(): List~SimulationResult~
    +saveResult(result: SimulationResult): SimulationResult
  }
  class DataGenerator {
    -dataDirectory: String
    +DataGenerator(dataDirectory: String)
    +generateAll(recordCount: int): void
    +generateStadiums(): void
    +generateSections(): void
    +generateSeats(recordCount: int): void
    +generateFans(): void
    +generateMatches(): void
    +clearGeneratedData(): void
  }
}

namespace Service {
  class SimulationService {
    -simulationRepository: SimulationRepository
    -dataGenerator: DataGenerator
    -bookingService: BookingService
    -executor: ExecutorService
    -strategyFactory: StrategyFactory
    +SimulationService(simulationRepository: SimulationRepository, dataGenerator: DataGenerator, bookingService: BookingService, strategyFactory: StrategyFactory)
    +generateCsvDataset(recordCount: int): void
    +configureSimulation(matchId: Long, targetSeatIds: List~Long~, concurrentUsers: int, mechanism: SyncMechanism): Simulation
    +runSimulation(simulationId: Long): SimulationResult
    +getSimulationResult(simulationId: Long): SimulationResult
    +compareSyncMechanisms(matchId: Long, concurrentUsers: int): List~SimulationResult~
    +shutdown(): void
  }
}

namespace Controller {
  class SimulationController {
    -simulationService: SimulationService
    +SimulationController(simulationService: SimulationService)
    +generateCsvDataset(recordCount: int): void
    +configureSimulation(matchId: Long, targetSeatIds: List~Long~, concurrentUsers: int, mechanism: SyncMechanism): Simulation
    +runSimulation(simulationId: Long): SimulationResult
    +getSimulationResult(simulationId: Long): SimulationResult
    +compareSyncMechanisms(matchId: Long, concurrentUsers: int): List~SimulationResult~
    +shutdown(): void
  }
}

SimulationController --> SimulationService
SimulationService --> SimulationRepository
SimulationService --> DataGenerator
SimulationService --> BookingService : calls executeBookingCore
SimulationService --> StrategyFactory
SimulationService --> BookingTask : submits tasks
BookingController --> BookingService
SimulationRepository --|> CsvRepository
SimulationRepository --> Simulation
SimulationRepository --> SimulationResult
Simulation "1" *-- "0..1" SimulationResult
Simulation --> SyncMechanism
Simulation --> SimulationStatus
BookingController --> Booking
BookingController --> MatchSeat
Booking --> BookingStatus
MatchSeat --> SeatStatus
Payment --> PaymentStatus
BookingTransaction --> TransactionStatus
BookingStrategy <|.. NoLockStrategy
BookingStrategy <|.. SynchronizedStrategy
BookingStrategy <|.. FileLockStrategy
BookingStrategy <|.. OptimisticLockStrategy
BookingTask --> BookingStrategy
StrategyFactory --> BookingStrategy
NoLockStrategy --> BookingService
SynchronizedStrategy --> BookingService
FileLockStrategy --> BookingService
OptimisticLockStrategy --> BookingService
OptimisticLockStrategy ..> OptimisticLockException

note for SimulationController "Delegates simulation commands; thread management stays in SimulationService."
note for SimulationService "Concurrent tasks call BookingService.executeBookingCore only; no payment or ticket issuance."

