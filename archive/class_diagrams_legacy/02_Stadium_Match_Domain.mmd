---
title: Stadium, Match and Ticket Pricing Domain
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, Arial, sans-serif"
    primaryTextColor: "#172033"
    lineColor: "#64748B"
---
classDiagram
direction TB

namespace Model {
  class BaseEntity {
    <<abstract>>
    #id: Long
    +BaseEntity(id: Long)
    +getId(): Long
    +toCsvLine(): String*
    +fromCsvLine(line: String): BaseEntity*
  }
  class Stadium {
    -name: String
    -address: String
    +Stadium(id: Long, name: String, address: String)
    +updateDetails(name: String, address: String): void
  }
  class Section {
    -stadiumId: Long
    -name: String
    +Section(id: Long, stadiumId: Long, name: String)
    +rename(name: String): void
  }
  class Seat {
    -sectionId: Long
    -rowLabel: String
    -seatNumber: int
    -version: int
    +Seat(id: Long, sectionId: Long, rowLabel: String, seatNumber: int)
    +getSeatLabel(): String
    +incrementVersion(): void
  }
  class Match {
    -stadiumId: Long
    -homeTeam: String
    -awayTeam: String
    -startTime: LocalDateTime
    -saleStatus: SaleStatus
    +Match(id: Long, stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime)
    +updateSchedule(startTime: LocalDateTime): void
    +openSales(): void
    +closeSales(): void
    +isOnSale(): boolean
  }
  class MatchSeat {
    -matchId: Long
    -seatId: Long
    -status: SeatStatus
    -version: int
    +MatchSeat(matchId: Long, seatId: Long)
    +isAvailable(): boolean
    +lock(expectedVersion: int): boolean
    +markBooked(expectedVersion: int): boolean
    +release(): void
  }
  class TicketPrice {
    -matchId: Long
    -sectionId: Long
    -amount: BigDecimal
    +TicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal)
    +changePrice(amount: BigDecimal): void
  }
  class SaleStatus { <<enumeration>> DRAFT OPEN CLOSED }
  class SeatStatus { <<enumeration>> AVAILABLE LOCKED BOOKED }
}

namespace Repository {
  class CsvRepository~T~ {
    <<abstract>>
    #filePath: Path
    +CsvRepository(filePath: Path)
    +findAll(): List~T~
    +findById(id: Long): T
    +findByCondition(condition: Predicate~T~): List~T~
    +save(entity: T): T
    +update(entity: T): T
    +delete(id: Long): boolean
  }
  class StadiumRepository {
    -stadiumFile: String
    -sectionFile: String
    +StadiumRepository(dataDirectory: String)
    +findAllStadiums(): List~Stadium~
    +findStadiumById(stadiumId: Long): Stadium
    +saveStadium(stadium: Stadium): Stadium
    +updateStadium(stadium: Stadium): Stadium
    +deleteStadium(stadiumId: Long): void
    +findSectionsByStadium(stadiumId: Long): List~Section~
    +findSectionById(sectionId: Long): Section
    +saveSection(section: Section): Section
    +updateSection(section: Section): Section
    +deleteSection(sectionId: Long): void
  }
  class SeatRepository {
    -seatFile: String
    +SeatRepository(dataDirectory: String)
    +findAll(): List~Seat~
    +findById(seatId: Long): Seat
    +findBySection(sectionId: Long): List~Seat~
    +findByCondition(condition: Predicate~Seat~): List~Seat~
    +save(seat: Seat): Seat
    +update(seat: Seat): Seat
    +updateIfVersion(seat: Seat, expectedVersion: int): boolean
    +delete(seatId: Long): boolean
  }
  class MatchRepository {
    -matchFile: String
    -matchSeatFile: String
    -ticketPriceFile: String
    +MatchRepository(dataDirectory: String)
    +findAll(): List~Match~
    +findById(matchId: Long): Match
    +search(keyword: String): List~Match~
    +save(match: Match): Match
    +update(match: Match): Match
    +delete(matchId: Long): void
    +findSeatsByMatch(matchId: Long): List~MatchSeat~
    +findMatchSeat(matchId: Long, seatId: Long): MatchSeat
    +updateMatchSeat(matchSeat: MatchSeat): MatchSeat
    +updateMatchSeatIfVersion(matchSeat: MatchSeat, expectedVersion: int): boolean
    +findPrice(matchId: Long, sectionId: Long): TicketPrice
    +saveOrUpdatePrice(ticketPrice: TicketPrice): TicketPrice
  }
}

namespace Service {
  class StadiumService {
    -stadiumRepository: StadiumRepository
    -seatRepository: SeatRepository
    -matchRepository: MatchRepository
    +StadiumService(stadiumRepository: StadiumRepository, seatRepository: SeatRepository, matchRepository: MatchRepository)
    +searchMatches(keyword: String): List~Match~
    +getMatchDetails(matchId: Long): Match
    +getSeatAvailability(matchId: Long): List~MatchSeat~
    +getStadiums(): List~Stadium~
    +getSections(stadiumId: Long): List~Section~
    +getSeats(sectionId: Long): List~Seat~
    +createStadium(name: String, address: String): Stadium
    +updateStadium(stadiumId: Long, name: String, address: String): Stadium
    +deleteStadium(stadiumId: Long): void
    +createSection(stadiumId: Long, name: String): Section
    +updateSection(sectionId: Long, name: String): Section
    +deleteSection(sectionId: Long): void
    +createSeat(sectionId: Long, rowLabel: String, seatNumber: int): Seat
    +updateSeat(seatId: Long, rowLabel: String, seatNumber: int): Seat
    +deleteSeat(seatId: Long): void
    +createMatch(stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime): Match
    +updateMatch(matchId: Long, startTime: LocalDateTime): Match
    +deleteMatch(matchId: Long): void
    +setTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice
    +openTicketSales(matchId: Long): Match
    +closeTicketSales(matchId: Long): Match
  }
}

namespace Controller {
  class StadiumController {
    -stadiumService: StadiumService
    +StadiumController(stadiumService: StadiumService)
    +searchMatches(keyword: String): List~Match~
    +getMatchDetails(matchId: Long): Match
    +getSeatAvailability(matchId: Long): List~MatchSeat~
    +getStadiums(): List~Stadium~
    +getSections(stadiumId: Long): List~Section~
    +getSeats(sectionId: Long): List~Seat~
    +createStadium(name: String, address: String): Stadium
    +updateStadium(stadiumId: Long, name: String, address: String): Stadium
    +deleteStadium(stadiumId: Long): void
    +createSection(stadiumId: Long, name: String): Section
    +updateSection(sectionId: Long, name: String): Section
    +deleteSection(sectionId: Long): void
    +createSeat(sectionId: Long, rowLabel: String, seatNumber: int): Seat
    +updateSeat(seatId: Long, rowLabel: String, seatNumber: int): Seat
    +deleteSeat(seatId: Long): void
    +createMatch(stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime): Match
    +updateMatch(matchId: Long, startTime: LocalDateTime): Match
    +deleteMatch(matchId: Long): void
    +setTicketPrice(matchId: Long, sectionId: Long, amount: BigDecimal): TicketPrice
    +openTicketSales(matchId: Long): Match
    +closeTicketSales(matchId: Long): Match
  }
}

StadiumController --> StadiumService
StadiumService --> StadiumRepository
StadiumService --> SeatRepository
StadiumService --> MatchRepository
StadiumRepository --|> CsvRepository
SeatRepository --|> CsvRepository
MatchRepository --|> CsvRepository
BaseEntity <|-- Stadium
BaseEntity <|-- Section
BaseEntity <|-- Seat
BaseEntity <|-- Match
StadiumRepository --> Stadium
StadiumRepository --> Section
SeatRepository --> Seat
MatchRepository --> Match
MatchRepository --> MatchSeat
MatchRepository --> TicketPrice
Stadium "1" *-- "0..*" Section
Section "1" *-- "0..*" Seat
Stadium "1" --> "0..*" Match
Match "1" *-- "0..*" MatchSeat
Seat "1" --> "0..*" MatchSeat
Match "1" --> "0..*" TicketPrice
Section "1" --> "0..*" TicketPrice
Match --> SaleStatus
MatchSeat --> SeatStatus

note for StadiumController "Public browsing and Admin commands delegate to one domain service."
note for StadiumService "Validates stadium, seat, match, pricing and ticket-sales business rules."

