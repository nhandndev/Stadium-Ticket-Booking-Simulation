---
title: User and Authentication Domain
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, Arial, sans-serif"
    primaryTextColor: "#172033"
    lineColor: "#64748B"
---
classDiagram
direction LR

namespace Model {
  class BaseEntity {
    <<abstract>>
    #id: Long
    +BaseEntity(id: Long)
    +getId(): Long
    +toCsvLine(): String*
    +fromCsvLine(line: String): BaseEntity*
  }
  class User {
    <<abstract>>
    -fullName: String
    -email: String
    -passwordHash: String
    -phone: String
    -role: UserRole
    -active: boolean
    +User(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole)
    +updateProfile(fullName: String, phone: String): void
    +deactivate(): void
    +isAdmin(): boolean
  }
  class Fan {
    +MAX_TICKETS_PER_TRANSACTION: int = 4
    +Fan(id: Long, fullName: String, email: String, passwordHash: String, phone: String)
    +canBook(ticketCount: int): boolean
  }
  class UserRole {
    <<enumeration>>
    FAN
    ADMIN
  }
}

namespace Repository {
  class CsvRepository~T~ {
    <<abstract>>
    #filePath: Path
    +CsvRepository(filePath: Path)
    +findAll(): List~T~
    +findById(id: Long): T
    +findByCondition(condition: Predicate~T~): List~T~
    +save(entity: T): T
    +update(entity: T): T
    +delete(id: Long): boolean
  }
  class FanRepository {
    -fileName: String
    +FanRepository(dataDirectory: String)
    +findAll(): List~Fan~
    +findById(fanId: Long): Fan
    +findByEmail(email: String): Fan
    +findByCondition(condition: Predicate~Fan~): List~Fan~
    +save(fan: Fan): Fan
    +update(fan: Fan): Fan
    +delete(fanId: Long): boolean
  }
}

namespace Service {
  class UserService {
    -fanRepository: FanRepository
    -currentUser: User
    +UserService(fanRepository: FanRepository)
    +register(fullName: String, email: String, password: String): Fan
    +login(email: String, password: String): User
    +logout(): void
    +updateProfile(fullName: String, phone: String): User
    +getCurrentUser(): User
    +getFans(): List~Fan~
    +createFanAccount(fullName: String, email: String): Fan
    +updateFanAccount(fanId: Long, fullName: String, phone: String): Fan
    +deactivateFanAccount(fanId: Long): Fan
    +deleteFanAccount(fanId: Long): boolean
  }
}

namespace Controller {
  class FanController {
    -userService: UserService
    +FanController(userService: UserService)
    +register(fullName: String, email: String, password: String): Fan
    +login(email: String, password: String): User
    +logout(): void
    +updateProfile(fullName: String, phone: String): User
    +getCurrentUser(): User
    +getFans(): List~Fan~
    +createFanAccount(fullName: String, email: String): Fan
    +updateFanAccount(fanId: Long, fullName: String, phone: String): Fan
    +deactivateFanAccount(fanId: Long): Fan
    +deleteFanAccount(fanId: Long): boolean
  }
}

BaseEntity <|-- User
User <|-- Fan
FanController --> UserService
UserService --> FanRepository
FanRepository --|> CsvRepository
FanRepository --> Fan
User --> UserRole

note for FanController "Receives console input and delegates user operations to UserService."
note for UserService "Owns authentication, current session, profile and Fan account rules."

