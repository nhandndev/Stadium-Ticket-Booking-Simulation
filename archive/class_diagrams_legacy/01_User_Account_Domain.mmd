style FanRepository fill:#FFF0D8,stroke:#A96F22,color:#172033
style BaseEntity fill:#E8F1F8,stroke:#35627A,color:#172033
style User fill:#E8F1F8,stroke:#35627A,color:#172033
style Fan fill:#E8F1F8,stroke:#35627A,color:#172033
