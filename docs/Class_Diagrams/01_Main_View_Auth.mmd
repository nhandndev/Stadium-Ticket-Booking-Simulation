classDiagram
    direction TB

    namespace VIEW {
        class Main {
            +main(args: String[]): void
        }

        class MainView {
            -authController: AuthController
            -browseController: BrowseController
            -fanController: FanController
            -bookingView: BookingView
            -sellerView: SellerView
            -gateView: GateView
            -adminManagementView: AdminManagementView
            -simulatorView: SimulatorView
            +MainView(authController: AuthController, browseController: BrowseController, fanController: FanController, bookingView: BookingView, sellerView: SellerView, gateView: GateView, adminManagementView: AdminManagementView, simulatorView: SimulatorView)
            +showGuestMenu(): void
            +showFanMenu(): void
            +showSellerMenu(): void
            +showGateStaffMenu(): void
            +showAdminMenu(): void
            +showSimulatorMenu(): void
            +start(): void
        }

        class BookingView {
            -bookingController: BookingController
            -refundController: RefundController
            -seatMapView: SeatMapView
            -fanController: FanController
            -ticketController: TicketController
            +BookingView(bookingController: BookingController, refundController: RefundController, seatMapView: SeatMapView, fanController: FanController, ticketController: TicketController)
            +showBookingMenu(): void
            +submitBooking(request: BookingRequestDto): void
            +displayBookingResponse(response: BookingResponseDto): void
            +showMyBookings(fanId: Long): void
            +showMyTickets(fanId: Long): void
            +showTicketDetails(ticketId: Long): void
            +showRefundMenu(fanId: Long): void
        }
    }

    namespace CONTROLLER {
        class AuthController {
            -authService: AuthService
            +AuthController(authService: AuthService)
            +login(request: LoginRequestDto): UserResponseDto
            +logout(): void
            +getCurrentUser(): UserResponseDto
            +updateCurrentUserProfile(request: ProfileUpdateRequestDto): UserResponseDto
        }

        class FanController {
            -fanService: FanService
            +FanController(fanService: FanService)
            +register(request: RegisterFanRequestDto): UserResponseDto
            +searchFans(keyword: String): List~UserResponseDto~
            +getMyTickets(fanId: Long): List~TicketResponseDto~
        }

        class BrowseController {
            -browseService: BrowseService
            +BrowseController(browseService: BrowseService)
            +searchMatches(keyword: String): List~MatchResponseDto~
            +filterMatches(stadiumId: Long, startDate: LocalDate): List~MatchResponseDto~
            +viewMatchDetails(matchId: Long): MatchResponseDto
            +getSeatMap(matchId: Long): List~MatchSeatResponseDto~
        }
    }

    namespace SERVICE {
        class AuthService {
            -fanRepository: FanRepository
            -staffRepository: StaffRepository
            -currentUser: User
            +AuthService(fanRepository: FanRepository, staffRepository: StaffRepository)
            +login(request: LoginRequestDto): UserResponseDto
            +logout(): void
            +getCurrentUser(): UserResponseDto
            +updateCurrentUserProfile(request: ProfileUpdateRequestDto): UserResponseDto
        }

        class FanService {
            -fanRepository: FanRepository
            -bookingRepository: BookingRepository
            -ticketRepository: TicketRepository
            +FanService(fanRepository: FanRepository, bookingRepository: BookingRepository, ticketRepository: TicketRepository)
            +register(request: RegisterFanRequestDto): UserResponseDto
            +searchFans(keyword: String): List~UserResponseDto~
            +getMyTickets(fanId: Long): List~TicketResponseDto~
        }

        class BrowseService {
            -matchRepository: MatchRepository
            -matchSeatRepository: MatchSeatRepository
            +BrowseService(matchRepository: MatchRepository, matchSeatRepository: MatchSeatRepository)
            +searchMatches(keyword: String): List~MatchResponseDto~
            +filterMatches(stadiumId: Long, startDate: LocalDate): List~MatchResponseDto~
            +viewMatchDetails(matchId: Long): MatchResponseDto
            +getSeatMap(matchId: Long): List~MatchSeatResponseDto~
        }
    }

    namespace DTO {
        class LoginRequestDto {
            -email: String
            -password: String
            +LoginRequestDto(email: String, password: String)
            +getEmail(): String
            +getPassword(): String
        }

        class RegisterFanRequestDto {
            -fullName: String
            -email: String
            -password: String
            -phone: String
            +RegisterFanRequestDto(fullName: String, email: String, password: String, phone: String)
            +getFullName(): String
            +getEmail(): String
            +getPassword(): String
            +getPhone(): String
        }

        class ProfileUpdateRequestDto {
            -fullName: String
            -phone: String
            +ProfileUpdateRequestDto(fullName: String, phone: String)
            +getFullName(): String
            +getPhone(): String
        }

        class UserResponseDto {
            -id: Long
            -fullName: String
            -email: String
            -phone: String
            -role: UserRole
            -status: UserStatus
            +UserResponseDto(id: Long, fullName: String, email: String, phone: String, role: UserRole, status: UserStatus)
            +getId(): Long
            +getRole(): UserRole
            +getFullName(): String
            +getEmail(): String
            +getPhone(): String
            +getStatus(): UserStatus
        }

        class MatchResponseDto {
            -id: Long
            -stadiumId: Long
            -homeTeam: String
            -awayTeam: String
            -startTime: LocalDateTime
            -saleStatus: SaleStatus
            +MatchResponseDto(id: Long, stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime, saleStatus: SaleStatus)
            +getId(): Long
            +getStadiumId(): Long
            +getHomeTeam(): String
            +getAwayTeam(): String
            +getStartTime(): LocalDateTime
            +getSaleStatus(): SaleStatus
        }

        class MatchSeatResponseDto {
            -id: Long
            -matchId: Long
            -seatId: Long
            -status: SeatStatus
            -version: int
            +MatchSeatResponseDto(id: Long, matchId: Long, seatId: Long, status: SeatStatus, version: int)
            +isAvailable(): boolean
            +getId(): Long
            +getMatchId(): Long
            +getSeatId(): Long
            +getStatus(): SeatStatus
            +getVersion(): int
        }

        class TicketResponseDto {
            -ticketId: Long
            -bookingId: Long
            -matchId: Long
            -seatId: Long
            -ticketCode: String
            -status: TicketStatus
            -checkedInAt: LocalDateTime
            +TicketResponseDto(ticketId: Long, bookingId: Long, matchId: Long, seatId: Long, ticketCode: String, status: TicketStatus, checkedInAt: LocalDateTime)
            +getTicketId(): Long
            +getTicketCode(): String
            +getBookingId(): Long
            +getMatchId(): Long
            +getSeatId(): Long
            +getStatus(): TicketStatus
            +getCheckedInAt(): LocalDateTime
        }
    }

    namespace REPOSITORY {
        class FanRepository {
            +FanRepository(filePath: Path)
            +findByEmail(email: String): Fan
            +search(keyword: String): List~Fan~
            #parseLine(line: String): Fan

            #formatLine(entity: Fan): String
        }

        class StaffRepository {
            +StaffRepository(filePath: Path)
            +findByEmail(email: String): Staff
            +search(keyword: String): List~Staff~
            #parseLine(line: String): Staff

            #formatLine(entity: Staff): String
        }

        class BookingRepository {
            +BookingRepository(filePath: Path)
            +findByFanId(fanId: Long): List~Booking~
            #parseLine(line: String): Booking

            #formatLine(entity: Booking): String
        }

        class MatchRepository {
            +MatchRepository(filePath: Path)
            +findUpcoming(): List~Match~
            #parseLine(line: String): Match

            #formatLine(entity: Match): String
        }

        class MatchSeatRepository {
            -filePath: Path
            +MatchSeatRepository(filePath: Path)
            +findByMatchId(matchId: Long): List~MatchSeat~
            +find(matchId: Long, seatId: Long): MatchSeat
            +save(seat: MatchSeat): MatchSeat
            +updateWithoutLock(seat: MatchSeat): boolean
            +updateSynchronized(seat: MatchSeat): boolean
            +updateWithFileLock(seat: MatchSeat): boolean
            +updateIfVersionMatches(seat: MatchSeat, expectedVersion: int): boolean
            #parseLine(line: String): MatchSeat
            #formatLine(entity: MatchSeat): String
        }

        class TicketRepository {
            +TicketRepository(filePath: Path)
            +findByBookingId(bookingId: Long): List~Ticket~
            +findByCode(ticketCode: String): Ticket
            +findByFanId(fanId: Long): List~Ticket~
            #parseLine(line: String): Ticket

            #formatLine(entity: Ticket): String
        }
    }

    namespace MODEL {
        class BaseEntity {
            <<abstract>>
            -id: Long
            +BaseEntity(id: Long)
            +getId(): Long
        }

        class User {
            -fullName: String
            -email: String
            -passwordHash: String
            -phone: String
            -role: UserRole
            -status: UserStatus
            +User(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)
            +updateProfile(fullName: String, phone: String): void
            +changeStatus(status: UserStatus): void
            +getFullName(): String
            +getEmail(): String
            +getPasswordHash(): String
            +getPhone(): String
            +getRole(): UserRole
            +getStatus(): UserStatus
        }

        class Fan {
            -MAX_TICKETS_PER_TRANSACTION: int = 4
            +Fan(id: Long, fullName: String, email: String, passwordHash: String, phone: String, status: UserStatus)
            +canBook(ticketCount: int): boolean
        }

        class Staff {
            +Staff(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)
            +assignRole(role: UserRole): void
        }

        class Match {
            -stadiumId: Long
            -homeTeam: String
            -awayTeam: String
            -startTime: LocalDateTime
            -saleStatus: SaleStatus
            +Match(id: Long, stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime, saleStatus: SaleStatus)
            +reschedule(startTime: LocalDateTime): void
            +changeSaleStatus(status: SaleStatus): void
            +getStadiumId(): Long
            +getHomeTeam(): String
            +getAwayTeam(): String
            +getStartTime(): LocalDateTime
            +getSaleStatus(): SaleStatus
        }

        class MatchSeat {
            -matchId: Long
            -seatId: Long
            -status: SeatStatus
            -version: int
            +MatchSeat(id: Long, matchId: Long, seatId: Long, status: SeatStatus, version: int)
            +isAvailable(): boolean
            +lock(): void
            +markBooked(): void
            +release(): void
            +getMatchId(): Long
            +getSeatId(): Long
            +getStatus(): SeatStatus
            +getVersion(): int
        }

        class UserRole {
            <<enumeration>>
            FAN
            SELLER
            GATE_STAFF
            ADMIN
            SIMULATOR_OPERATOR
        }
        class UserStatus {
            <<enumeration>>
            ACTIVE
            INACTIVE
        }
        class SaleStatus {
            <<enumeration>>
            CLOSED
            OPEN
        }
        class SeatStatus {
            <<enumeration>>
            AVAILABLE
            LOCKED
            BOOKED
        }
        class TicketStatus {
            <<enumeration>>
            PENDING
            ISSUED
            CHECKED_IN
            CANCELLED
        }
    }

    Main --> MainView
    MainView --> AuthController
    MainView --> FanController
    MainView --> BrowseController
    MainView --> BookingView
    AuthController --> AuthService
    FanController --> FanService
    BrowseController --> BrowseService
    AuthService --> FanRepository
    AuthService --> StaffRepository
    FanService --> FanRepository
    FanService --> BookingRepository
    FanService --> TicketRepository
    BrowseService --> MatchRepository
    BrowseService --> MatchSeatRepository
    Fan --|> User
    Staff --|> User
    User --|> BaseEntity
    Match --|> BaseEntity
    MatchSeat --|> BaseEntity

