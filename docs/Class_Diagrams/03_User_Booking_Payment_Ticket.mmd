    BookingService --> TicketPriceRepository
    BookingService --> PaymentRepository
    BookingService --> TicketRepository
    BookingService --> StrategyFactory
    BookingService --> MockPaymentService
    TicketService --> TicketRepository
    RefundService --> RefundRepository
    BookingController --> BookingView
    BookingController --> SellerView
    BookingController --> SeatMapView
    BookingController --> BrowseController
    BookingController --> FanController
    BookingController --> RefundController
    BookingController --> TicketController
    TicketController --> GateView

    class SynchronizedStrategy {
        -matchSeatRepository: MatchSeatRepository
        -transactionRepository: TransactionRepository
        +SynchronizedStrategy(matchSeatRepository: MatchSeatRepository, transactionRepository: TransactionRepository)
        +execute(fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
        +execute(bookingId: Long, fanId: Long, matchId: Long, seatIds: List~Long~): BookingTransaction
    }

    class SyncMechanism {
        <<enumeration>>
        SYNCHRONIZED
    }

    class TransactionStatus {
        <<enumeration>>
        SUCCESS
        FAILED
        CONFLICT
    }

    SynchronizedStrategy ..|> BookingStrategy
    StrategyFactory ..> SynchronizedStrategy
    SynchronizedStrategy --> MatchSeatRepository
    SynchronizedStrategy --> TransactionRepository
    BookingTransaction ..> SyncMechanism
    BookingTransaction ..> TransactionStatus
