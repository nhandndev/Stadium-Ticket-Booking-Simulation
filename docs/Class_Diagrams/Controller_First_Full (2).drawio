  <diagram id="d872" name="05_Repository_Persistence">
    <mxGraphModel arrows="1" connect="1" dx="1275" dy="721" fold="1" grid="1" gridSize="10" guides="1" math="0" page="1" pageHeight="4400" pageScale="1" pageWidth="15100" shadow="0" tooltips="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="xte9v4NUDdnIVVm1DSTO-1" label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    namespace REPOSITORY {\n        class CsvRepository~T~ {\n            &lt;&lt;abstract&gt;&gt;\n            #filePath: Path\n            +CsvRepository(filePath: Path)\n            +findAll(): List~T~\n            +findById(id: Long): T\n            +findByCondition(condition: Predicate~T~): List~T~\n            +save(entity: T): T\n            +update(entity: T): T\n            +delete(id: Long): boolean\n            #parseLine(line: String): T\n\n            #formatLine(entity: T): String\n        }\n\n        class FanRepository {\n            +FanRepository(filePath: Path)\n            +findByEmail(email: String): Fan\n            +search(keyword: String): List~Fan~\n            #parseLine(line: String): Fan\n\n            #formatLine(entity: Fan): String\n        }\n\n        class StaffRepository {\n            +StaffRepository(filePath: Path)\n            +findByEmail(email: String): Staff\n            +search(keyword: String): List~Staff~\n            #parseLine(line: String): Staff\n\n            #formatLine(entity: Staff): String\n        }\n\n        class StadiumRepository {\n            +StadiumRepository(filePath: Path)\n            +findByName(name: String): List~Stadium~\n            #parseLine(line: String): Stadium\n\n            #formatLine(entity: Stadium): String\n        }\n\n        class SectionRepository {\n            +SectionRepository(filePath: Path)\n            +findByStadiumId(stadiumId: Long): List~Section~\n            #parseLine(line: String): Section\n\n            #formatLine(entity: Section): String\n        }\n\n        class SeatRepository {\n            +SeatRepository(filePath: Path)\n            +findBySectionId(sectionId: Long): List~Seat~\n            #parseLine(line: String): Seat\n\n            #formatLine(entity: Seat): String\n        }\n\n        class MatchRepository {\n            +MatchRepository(filePath: Path)\n            +findUpcoming(): List~Match~\n            #parseLine(line: String): Match\n\n            #formatLine(entity: Match): String\n        }\n\n        class BookingRepository {\n            +BookingRepository(filePath: Path)\n            +findByFanId(fanId: Long): List~Booking~\n            #parseLine(line: String): Booking\n\n            #formatLine(entity: Booking): String\n        }\n\n        class PaymentRepository {\n            +PaymentRepository(filePath: Path)\n            +findByBookingId(bookingId: Long): Payment\n            #parseLine(line: String): Payment\n\n            #formatLine(entity: Payment): String\n        }\n\n        class TicketRepository {\n            +TicketRepository(filePath: Path)\n            +findByBookingId(bookingId: Long): List~Ticket~\n            +findByCode(ticketCode: String): Ticket\n            +findByFanId(fanId: Long): List~Ticket~\n            #parseLine(line: String): Ticket\n\n            #formatLine(entity: Ticket): String\n        }\n\n        class TransactionRepository {\n            +TransactionRepository(filePath: Path)\n            +findBySimulationId(simulationId: Long): List~BookingTransaction~\n            #parseLine(line: String): BookingTransaction\n\n            #formatLine(entity: BookingTransaction): String\n        }\n\n        class SimulationRepository {\n            +SimulationRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~Simulation~\n            #parseLine(line: String): Simulation\n\n            #formatLine(entity: Simulation): String\n        }\n\n        class SimulationResultRepository {\n            +SimulationResultRepository(filePath: Path)\n            +findBySimulationId(simulationId: Long): List~SimulationResult~\n            +exportResult(simulationId: Long, filePath: Path): boolean\n            #parseLine(line: String): SimulationResult\n\n            #formatLine(entity: SimulationResult): String\n        }\n\n        class RefundRepository {\n            +RefundRepository(filePath: Path)\n            +findByFanId(fanId: Long): List~RefundRequest~\n            +findPending(): List~RefundRequest~\n            #parseLine(line: String): RefundRequest\n\n            #formatLine(entity: RefundRequest): String\n        }\n\n        class AuditLogRepository {\n            +AuditLogRepository(filePath: Path)\n            +append(log: AuditLog): void\n            +findRecent(limit: int): List~AuditLog~\n            #parseLine(line: String): AuditLog\n\n            #formatLine(entity: AuditLog): String\n        }\n\n        class MatchSeatRepository {\n            -filePath: Path\n            +MatchSeatRepository(filePath: Path)\n            +findByMatchId(matchId: Long): List~MatchSeat~\n            +find(matchId: Long, seatId: Long): MatchSeat\n            +save(seat: MatchSeat): MatchSeat\n            +updateWithoutLock(seat: MatchSeat): boolean\n            +updateSynchronized(seat: MatchSeat): boolean\n            +updateWithFileLock(seat: MatchSeat): boolean\n            +updateIfVersionMatches(seat: MatchSeat, expectedVersion: int): boolean\n            #parseLine(line: String): MatchSeat\n            #formatLine(entity: MatchSeat): String\n        }\n\n        class TicketPriceRepository {\n            -filePath: Path\n            +TicketPriceRepository(filePath: Path)\n            +findPrice(matchId: Long, sectionId: Long): TicketPrice\n            +findByMatchId(matchId: Long): List~TicketPrice~\n            +save(price: TicketPrice): TicketPrice\n            +update(price: TicketPrice): TicketPrice\n            +delete(matchId: Long, sectionId: Long): boolean\n            #parseLine(line: String): TicketPrice\n            #formatLine(entity: TicketPrice): String\n        }\n\n        class DataGenerator {\n            -outputDirectory: Path\n            +DataGenerator(outputDirectory: Path)\n            +generateAll(recordCount: int): void\n            +generateStadiums(): void\n            +generateSections(): void\n            +generateSeats(recordCount: int): void\n            +generateFans(): void\n            +generateStaff(): void\n            +generateMatches(): void\n            +clearGeneratedData(): void\n        }\n\n    }\n\n    namespace MODEL {\n        class BaseEntity {\n            &lt;&lt;abstract&gt;&gt;\n            #id: Long\n            +BaseEntity(id: Long)\n            +getId(): Long\n        }\n\n        class MatchSeat {\n            -matchId: Long\n            -seatId: Long\n            -status: SeatStatus\n            -version: int\n            +MatchSeat(id: Long, matchId: Long, seatId: Long, status: SeatStatus, version: int)\n            +isAvailable(): boolean\n            +lock(): void\n            +markBooked(): void\n            +release(): void\n            +getMatchId(): Long\n            +getSeatId(): Long\n            +getStatus(): SeatStatus\n            +getVersion(): int\n        }\n\n        class Simulation {\n            -matchId: Long\n            -targetSeatIds: List~Long~\n            -threadCount: int\n            -mechanism: SyncMechanism\n            -status: SimulationStatus\n            +Simulation(id: Long, matchId: Long, targetSeatIds: List~Long~, threadCount: int, mechanism: SyncMechanism)\n            +start(): void\n            +complete(): void\n            +getMatchId(): Long\n            +getTargetSeatIds(): List~Long~\n            +getThreadCount(): int\n            +getMechanism(): SyncMechanism\n            +getStatus(): SimulationStatus\n        }\n\n        class SimulationResult {\n            -simulationId: Long\n            -mechanism: SyncMechanism\n            -threadCount: int\n            -attemptCount: int\n            -successCount: int\n            -failedCount: int\n            -conflictCount: int\n            -doubleBookingCount: int\n            -durationMillis: long\n            +SimulationResult(id: Long, simulationId: Long, mechanism: SyncMechanism, threadCount: int)\n            +recordAttempt(success: boolean, conflict: boolean, doubleBooking: boolean): void\n            +calculateThroughput(): double\n            +calculateDoubleBookingRate(): double\n            +getSimulationId(): Long\n            +getMechanism(): SyncMechanism\n            +getThreadCount(): int\n            +getAttemptCount(): int\n            +getSuccessCount(): int\n            +getFailedCount(): int\n            +getConflictCount(): int\n            +getDoubleBookingCount(): int\n            +getDurationMillis(): long\n        }\n\n        class User {\n            -fullName: String\n            -email: String\n            -passwordHash: String\n            -phone: String\n            -role: UserRole\n            -status: UserStatus\n            +User(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)\n            +updateProfile(fullName: String, phone: String): void\n            +changeStatus(status: UserStatus): void\n            +getFullName(): String\n            +getEmail(): String\n            +getPasswordHash(): String\n            +getPhone(): String\n            +getRole(): UserRole\n            +getStatus(): UserStatus\n        }\n\n        class Fan {\n            -MAX_TICKETS_PER_TRANSACTION: int = 4\n            +Fan(id: Long, fullName: String, email: String, passwordHash: String, phone: String, status: UserStatus)\n            +canBook(ticketCount: int): boolean\n        }\n\n        class Staff {\n            +Staff(id: Long, fullName: String, email: String, passwordHash: String, phone: String, role: UserRole, status: UserStatus)\n            +assignRole(role: UserRole): void\n        }\n\n        class Stadium {\n            -name: String\n            -address: String\n            +Stadium(id: Long, name: String, address: String)\n            +updateDetails(name: String, address: String): void\n            +getName(): String\n            +getAddress(): String\n        }\n\n        class Section {\n            -stadiumId: Long\n            -name: String\n            +Section(id: Long, stadiumId: Long, name: String)\n            +rename(name: String): void\n            +getStadiumId(): Long\n            +getName(): String\n        }\n\n        class Seat {\n            -sectionId: Long\n            -rowLabel: String\n            -seatNumber: int\n            -active: boolean\n            +Seat(id: Long, sectionId: Long, rowLabel: String, seatNumber: int, active: boolean)\n            +updateLocation(rowLabel: String, seatNumber: int): void\n            +activate(): void\n            +deactivate(): void\n            +getSectionId(): Long\n            +getRowLabel(): String\n            +getSeatNumber(): int\n            +isActive(): boolean\n        }\n\n        class Match {\n            -stadiumId: Long\n            -homeTeam: String\n            -awayTeam: String\n            -startTime: LocalDateTime\n            -saleStatus: SaleStatus\n            +Match(id: Long, stadiumId: Long, homeTeam: String, awayTeam: String, startTime: LocalDateTime, saleStatus: SaleStatus)\n            +reschedule(startTime: LocalDateTime): void\n            +changeSaleStatus(status: SaleStatus): void\n            +getStadiumId(): Long\n            +getHomeTeam(): String\n            +getAwayTeam(): String\n            +getStartTime(): LocalDateTime\n            +getSaleStatus(): SaleStatus\n        }\n\n        class Booking {\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            -totalAmount: BigDecimal\n            -status: BookingStatus\n            +Booking(id: Long, fanId: Long, matchId: Long, seatIds: List~Long~, totalAmount: BigDecimal, status: BookingStatus)\n            +validateTicketLimit(): void\n            +confirm(): void\n            +cancel(): void\n            +getFanId(): Long\n            +getMatchId(): Long\n            +getSeatIds(): List~Long~\n            +getTotalAmount(): BigDecimal\n            +getStatus(): BookingStatus\n        }\n\n        class Payment {\n            -bookingId: Long\n            -amount: BigDecimal\n            -method: PaymentMethod\n            -status: PaymentStatus\n            +Payment(id: Long, bookingId: Long, amount: BigDecimal, method: PaymentMethod, status: PaymentStatus)\n            +markSuccess(): void\n            +markFailed(): void\n            +getBookingId(): Long\n            +getAmount(): BigDecimal\n            +getMethod(): PaymentMethod\n            +getStatus(): PaymentStatus\n        }\n\n        class Ticket {\n            -bookingId: Long\n            -matchId: Long\n            -seatId: Long\n            -ticketCode: String\n            -status: TicketStatus\n            -checkedInAt: LocalDateTime\n            +Ticket(id: Long, bookingId: Long, matchId: Long, seatId: Long, ticketCode: String, status: TicketStatus)\n            +issue(): void\n            +isValidForMatch(matchId: Long): boolean\n            +checkIn(time: LocalDateTime): void\n            +cancel(): void\n            +getBookingId(): Long\n            +getMatchId(): Long\n            +getSeatId(): Long\n            +getTicketCode(): String\n            +getStatus(): TicketStatus\n            +getCheckedInAt(): LocalDateTime\n        }\n\n        class BookingTransaction {\n            -simulationId: Long\n            -bookingId: Long\n            -fanId: Long\n            -matchId: Long\n            -seatIds: List~Long~\n            -mechanism: SyncMechanism\n            -status: TransactionStatus\n            -createdAt: LocalDateTime\n            -completedAt: LocalDateTime\n            -durationMillis: long\n            -failureReason: String\n            +BookingTransaction(id: Long, fanId: Long, matchId: Long, seatIds: List~Long~, mechanism: SyncMechanism)\n            +attachBooking(bookingId: Long): void\n            +attachSimulation(simulationId: Long): void\n            +markSuccessful(completedAt: LocalDateTime): void\n            +markFailed(reason: String, completedAt: LocalDateTime): void\n            +calculateDuration(): long\n            +getSimulationId(): Long\n            +getBookingId(): Long\n            +getFanId(): Long\n            +getMatchId(): Long\n            +getSeatIds(): List~Long~\n            +getMechanism(): SyncMechanism\n            +getStatus(): TransactionStatus\n            +getCreatedAt(): LocalDateTime\n            +getCompletedAt(): LocalDateTime\n            +getDurationMillis(): long\n            +getFailureReason(): String\n        }\n\n        class RefundRequest {\n            -bookingId: Long\n            -fanId: Long\n            -reason: String\n            -status: RefundStatus\n            -requestedAt: LocalDateTime\n            -reviewedBy: Long\n            -reviewedAt: LocalDateTime\n            -reviewNote: String\n            +RefundRequest(id: Long, bookingId: Long, fanId: Long, reason: String, requestedAt: LocalDateTime)\n            +approve(adminId: Long, note: String, time: LocalDateTime): void\n            +reject(adminId: Long, note: String, time: LocalDateTime): void\n            +getBookingId(): Long\n            +getFanId(): Long\n            +getReason(): String\n            +getStatus(): RefundStatus\n            +getRequestedAt(): LocalDateTime\n            +getReviewedBy(): Long\n            +getReviewedAt(): LocalDateTime\n            +getReviewNote(): String\n        }\n\n        class AuditLog {\n            -actorId: Long\n            -action: String\n            -targetType: String\n            -targetId: Long\n            -result: String\n            -createdAt: LocalDateTime\n            +AuditLog(id: Long, actorId: Long, action: String, targetType: String, targetId: Long, result: String, createdAt: LocalDateTime)\n            +getActorId(): Long\n            +getAction(): String\n            +getTargetType(): String\n            +getTargetId(): Long\n            +getResult(): String\n            +getCreatedAt(): LocalDateTime\n        }\n\n    }\n\n    namespace EXCEPTIONS {\n        class EntityNotFoundException {\n            +EntityNotFoundException(message: String)\n        }\n\n        class InvalidBookingException {\n            +InvalidBookingException(message: String)\n        }\n\n        class SeatAlreadyBookedException {\n            +SeatAlreadyBookedException(message: String)\n        }\n\n        class PaymentFailedException {\n            +PaymentFailedException(message: String)\n        }\n\n        class CsvDataException {\n            +CsvDataException(message: String)\n        }\n\n        class OptimisticLockException {\n            +OptimisticLockException(message: String)\n        }\n\n        class RuntimeException {\n            +RuntimeException(message: String)\n        }\n\n    }\n\n    FanRepository --|&gt; CsvRepository~T~\n    StaffRepository --|&gt; CsvRepository~T~\n    SeatRepository --|&gt; CsvRepository~T~\n    MatchRepository --|&gt; CsvRepository~T~\n    TicketRepository --|&gt; CsvRepository~T~\n    StadiumRepository --|&gt; CsvRepository~T~\n    SectionRepository --|&gt; CsvRepository~T~\n    BookingRepository --|&gt; CsvRepository~T~\n    PaymentRepository --|&gt; CsvRepository~T~\n    SimulationRepository --|&gt; CsvRepository~T~\n    SimulationResultRepository --|&gt; CsvRepository~T~\n    TransactionRepository --|&gt; CsvRepository~T~\n    RefundRepository --|&gt; CsvRepository~T~\n    AuditLogRepository --|&gt; CsvRepository~T~\n    User --|&gt; BaseEntity\n    Fan --|&gt; User\n    Staff --|&gt; User\n    Stadium --|&gt; BaseEntity\n    Section --|&gt; BaseEntity\n    Seat --|&gt; BaseEntity\n    Match --|&gt; BaseEntity\n    MatchSeat --|&gt; BaseEntity\n    Payment --|&gt; BaseEntity\n    Ticket --|&gt; BaseEntity\n    BookingTransaction --|&gt; BaseEntity\n    Simulation --|&gt; BaseEntity\n    SimulationResult --|&gt; BaseEntity\n    Booking --|&gt; BaseEntity\n    RefundRequest --|&gt; BaseEntity\n    AuditLog --|&gt; BaseEntity\n    DataGenerator ..&gt; CsvRepository~T~\n    RuntimeException &lt;|-- EntityNotFoundException\n    RuntimeException &lt;|-- InvalidBookingException\n    RuntimeException &lt;|-- SeatAlreadyBookedException\n    RuntimeException &lt;|-- PaymentFailedException\n    RuntimeException &lt;|-- CsvDataException\n    RuntimeException &lt;|-- OptimisticLockException\n\n    classDef view fill:#eef6ff,stroke:#3b82f6,color:#102a43,stroke-width:1px\n    classDef controller fill:#edfcf3,stroke:#22a06b,color:#102a43,stroke-width:1px\n    classDef repository fill:#fff7e8,stroke:#d97706,color:#102a43,stroke-width:1px\n    classDef model fill:#f7f0ff,stroke:#845ec2,color:#102a43,stroke-width:1px\n    classDef helper fill:#f1f5f9,stroke:#64748b,color:#102a43,stroke-width:1px\n    %% Generic class keeps Mermaid default style; cannot apply class style to ~T~.\n    class FanRepository repository\n    class StaffRepository repository\n    class StadiumRepository repository\n    class SectionRepository repository\n    class SeatRepository repository\n    class MatchRepository repository\n    class BookingRepository repository\n    class PaymentRepository repository\n    class TicketRepository repository\n    class TransactionRepository repository\n    class SimulationRepository repository\n    class SimulationResultRepository repository\n    class RefundRepository repository\n    class AuditLogRepository repository\n    class MatchSeatRepository repository\n    class TicketPriceRepository repository\n    class DataGenerator repository\n    class BaseEntity model\n    class User model\n    class MatchSeat model\n    class Simulation model\n    class SimulationResult model\n    class Fan model\n    class Staff model\n    class Stadium model\n    class Section model\n    class Seat model\n    class Match model\n    class Booking model\n    class Payment model\n    class Ticket model\n    class BookingTransaction model\n    class RefundRequest model\n    class AuditLog model\n    class EntityNotFoundException helper\n    class InvalidBookingException helper\n    class SeatAlreadyBookedException helper\n    class PaymentFailedException helper\n    class CsvDataException helper\n    class OptimisticLockException helper\n    class RuntimeException helper\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}">
